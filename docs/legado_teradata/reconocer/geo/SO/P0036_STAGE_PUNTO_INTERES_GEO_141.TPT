DEFINE JOB ExportarArchivo
DESCRIPTION 'Exporta Registros a PUNTO_DE_INTERES_GEO'
( 
 
  DEFINE SCHEMA PUNTO_DE_INTERES_GEO_SCHEMA
  DESCRIPTION 'PUNTO_DE_INTERES_GEO SCHEMA' 
	( 
		OBJECTID               VARCHAR (50)
		,POI_ID                VARCHAR (50)
		,CAT_ID                 VARCHAR (100)
		,POI_NAME               VARCHAR (200)
		,Descripcion_CAT_ID     VARCHAR (100)
		,Municipio              VARCHAR (50)
		,Departamento           VARCHAR (50)
		,POINT_X                VARCHAR (50)
		,POINT_Y                VARCHAR (50)

	);

 
  DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName     = @UserName
     ,VARCHAR UserPassword = @UserPassword
     ,VARCHAR TdpId        = @TdpId
     ,VARCHAR AccountID
     ,VARCHAR ARRAY ErrorList = ['3803','3807']
    );


 DEFINE OPERATOR FILE_EXPORT
	DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DATA CONNECTOR OPERATOR'
	TYPE DATACONNECTOR CONSUMER
	SCHEMA PUNTO_DE_INTERES_GEO_SCHEMA
	ATTRIBUTES
	(
	VARCHAR DirectoryPath   = @ENTRADAS,
	VARCHAR FileName        = @DATAFILE,      
	VARCHAR IndicatorMode   = 'N',
	VARCHAR OpenMode        = 'Write',
	VARCHAR Format          = 'Delimited',
	VARCHAR TextDelimiter   = '|'
	);


DEFINE OPERATOR Select_PLANO_POI
 TYPE SELECTOR
 SCHEMA PUNTO_DE_INTERES_GEO_SCHEMA
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt = ' SEL  CAST( OBJECTID AS VARCHAR(50) ) OBJECTID
							,POI_ID                        
							,CAT_ID                        
							,POI_Name                      
							,Descripcion_CAT_ID            
							,Municipio                     
							,Departamento                  
							,CAST(Point_X  AS VARCHAR(50) )  Point_X
							,CAST(Point_Y  AS VARCHAR(50) )  Point_Y
				       FROM '|| @BDSTAGE ||'.TMP_PLANO_POINT ' 
 );
 
	STEP Generacion_File_Poi
	 (
		APPLY
			TO OPERATOR
			(FILE_EXPORT[1])	 
		SELECT  *
		FROM OPERATOR (Select_PLANO_POI[1]);
	 ); 
	
 
 ); 
 
 
 