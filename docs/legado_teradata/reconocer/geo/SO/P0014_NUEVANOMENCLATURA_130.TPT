DEFINE JOB P0014_NUEVANOMENCLATURA_130
DESCRIPTION 'Paso del Proceso de carga sobre tabla final "NUEVANOMENCLATURA" a partir de la vista VSTG_CargaNUEVANOMENCLATURAs Paso 130'
(  
DEFINE SCHEMA NUEVANOMENCLATURA
    DESCRIPTION 'Schema Estructura de la Vista'
    ( 
	   IN_Cod_DW_Ubic_Nomenc BIGINT /*#1*/
      ,IN_Cod_DW_Ubic_Act BIGINT /*#1*/
      ,IN_Cod_Numero_Nomenclatura VARCHAR(60)
      ,IN_Texto_Nueva_Nomencl VARCHAR(60)
      ,IN_LOTE INTEGER
      ,IN_Fecha_Actualizacion ANSIDATE
      ,IN_Usuario_BD VARCHAR(30) 
      ,IN_Texto_Nomencl_Orig VARCHAR(60)
      ,IN_Cod_DW_Ubic BIGINT /*#1*/
      ,IN_Severidad BYTEINT
	  ,IN_Desc_Severidad VARCHAR (77)
	  ,IN_COD_RECHAZO VARCHAR (30)
	  ,IN_AVENIDA_BDLNEWDIRBOG VARCHAR (2)
	  ,IN_NUMCOD_BDLNEWDIRBOG VARCHAR (60)
	  ,IN_DIRORI_BDLNEWDIRBOG VARCHAR (60)
	  ,IN_DIRNEW_BDLNEWDIRBOG VARCHAR (60)
	  
    );    


    /* ================================================================
       Definición del Operador "Fexp" (Vista)
       ================================================================ */
    
    DEFINE OPERATOR FEXP_OPERATOR 
    TYPE EXPORT                   
    SCHEMA NUEVANOMENCLATURA          
    ATTRIBUTES                    
    (                          
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
     ,INTEGER MaxSessions                   
     ,INTEGER MinSessions                   
     ,VARCHAR AccountID                                    
     ,VARCHAR PrivateLogName                               
     ,VARCHAR TraceLevel                                   
     ,VARCHAR WorkingDatabase                              
     ,VARCHAR ErrorTable   = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours 
     ,INTEGER TenacitySleep 
     ,VARCHAR SelectStmt    = 'SELECT * FROM  '||@BDSTAGE||'.VstgCargaNomenclatura;');
	
    /* ================================================================
       Definición de (Tabla(s) Destino)
       ================================================================  */
    
     DEFINE OPERATOR OPERATOR_130
    DESCRIPTION 'TERADATA WAREHOUSE BUILDER UPDATE OPERATOR'
    TYPE UPDATE 
	 SCHEMA NUEVANOMENCLATURA  
    ATTRIBUTES  
    (                             /* Si son varias: VARCHAR ARRAY TargetTable = ['Trans','Accounts','Customer'] */ 
      VARCHAR UserName          = @UserName     
     ,VARCHAR UserPassword      = @UserPassword 
     ,VARCHAR TdpId             = @TdpId        
     ,VARCHAR AccountId         
							


	 ,VARCHAR ARRAY TargetTable = [@BDDATOS ||'.'||@TablaDestino1 ,@BDSTAGE ||'.'||@LAYOUT||'_IN', @BDSTAGE||'.'||@LAYOUT||'_DUP']  							
     ,VARCHAR ARRAY ErrorTable1 = [@BDTEMPO ||'.'||@Wktb 		  ,	@BDTEMPO||'.'||@Wktb||'_IN'			, @BDTEMPO||'.'||@Wktb||'_DUP']  
     ,VARCHAR ARRAY ErrorTable2 = [@BDTEMPO ||'.'||@Err1 		  ,	@BDTEMPO||'.'||@Err1||'_IN'			, @BDTEMPO||'.'||@Err1||'_DUP']  
     ,VARCHAR ARRAY WorkTable   = [@BDTEMPO ||'.'||@Err2 		  ,	@BDTEMPO||'.'||@Err2||'_IN'			, @BDTEMPO||'.'||@Err2||'_DUP']  
	 
	
     ,VARCHAR LogTable     = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours 
     ,INTEGER TenacitySleep 
    );
    
    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
       (
        VARCHAR UserName = @UserName,
        VARCHAR UserPassword = @UserPassword,
        VARCHAR TdpId = @TdpId,
        VARCHAR ARRAY ErrorList = ['3803','3807','5978']
       );

	 
	
    /* ====================================================================
        Apply Upsert Usando Mload Desde lo que entregó el Fexp
       ====================================================================  */
    
    STEP Load_TIPO_NUEVANOMENCLATURA
    (             
     APPLY        
           CASE   
                WHEN ( IN_Severidad < 3  )                          /*  Upsert a HR_POSITION  */
                THEN (
                           'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'
                            SET     
                                   LOTE_ACTUALIZACION    	 =  ' || @LOTE ||'
								   ,Fecha_Actualizacion		 =  :IN_Fecha_Actualizacion
								   ,Cod_DW_Ubic_Act		 	 =  :IN_Cod_DW_Ubic_Act
								   ,Cod_Numero_Nomenclatura  =  :IN_Cod_Numero_Nomenclatura
									
                            WHERE   
                                    Cod_DW_Ubic_Nomenc      = :IN_Cod_DW_Ubic_Nomenc;
                           '	
                          ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino1||' 
                               (	 
							     Cod_DW_Ubic_Nomenc 
								  ,Cod_DW_Ubic_Act 
								  ,Cod_Numero_Nomenclatura
								  ,Texto_Nueva_Nomencl 
								  ,LOTE 
								  ,Fecha_Actualizacion
								  ,Usuario_BD 
								  ,Texto_Nomencl_Orig
								  ,Cod_DW_Ubic
								  ,Severidad
								  
                          	  )
                          VALUES
                             (  
								  :IN_Cod_DW_Ubic_Nomenc 
								  ,:IN_Cod_DW_Ubic_Act 
								  ,:IN_Cod_Numero_Nomenclatura
								  ,:IN_Texto_Nueva_Nomencl 
								  ,'|| @LOTE ||' 
								  ,:IN_Fecha_Actualizacion
								  ,:IN_Usuario_BD 
								  ,:IN_Texto_Nomencl_Orig
								  ,:IN_Cod_DW_Ubic
								  ,:IN_Severidad
								  
                           	  );'
                   			                     
                
				    )
				INSERT FOR MISSING UPDATE ROWS
            END,

           CASE WHEN ( IN_Severidad <> 1 AND IN_Severidad <>5 ) /* Upsert a Rechazados */
                THEN 
                     (
                      'INSERT INTO ' ||@BDSTAGE||'.'||@LAYOUT||'_IN
                               ( 
                                 
							 AVENIDA_BDLNEWDIRBOG 
							 ,NUMCOD_BDLNEWDIRBOG 
							 ,DIRORI_BDLNEWDIRBOG 
							 ,DIRNEW_BDLNEWDIRBOG 
							 ,NOMBRE_ARCHIVO_PLANO
                             ,FECHA_CARGA 	 	
                             ,Cod_DW_Ubic_Nomenc
                             ,Cod_DW_Ubic_Act	
                             ,Cod_DW_Ubic			 
                             ,LOTE   				 
                             ,SEVERIDAD		    
                             ,COD_RECHAZO		
								 
                               )                      
                       VALUES  
							(							     
							  :IN_AVENIDA_BDLNEWDIRBOG
                             ,:IN_NUMCOD_BDLNEWDIRBOG 
                             ,:IN_DIRORI_BDLNEWDIRBOG 
                             ,:IN_DIRNEW_BDLNEWDIRBOG
							 ,'''|| @DATAFILE || '''
                             , CURRENT_DATE	
                             ,:IN_Cod_DW_Ubic_Nomenc 
                             ,:IN_Cod_DW_Ubic_Act	 
                             ,:IN_Cod_DW_Ubic                      
                             ,' || @LOTE || '  
							 ,:IN_SEVERIDAD		  
                             ,:IN_COD_RECHAZO
                               )                      
                       ;'                             
                     )
           END   ,
CASE WHEN ( IN_Severidad =5 ) /* Upsert a Rechazados */
                THEN 	
 
			'INSERT INTO ' ||@BDSTAGE||'.'||@LAYOUT||'_DUP
              (
          
		  
				  AVENIDA_BDLNEWDIRBOG 
				,NUMCOD_BDLNEWDIRBOG   
				,DIRORI_BDLNEWDIRBOG   
				,DIRNEW_BDLNEWDIRBOG   
				,NOMBRE_ARCHIVO_PLANO  
				,FECHA_CARGA       	   
				,LOTE  				   
				)
			VALUES (

			  :IN_AVENIDA_BDLNEWDIRBOG 
				,:IN_NUMCOD_BDLNEWDIRBOG   
				,:IN_DIRORI_BDLNEWDIRBOG   
				,:IN_DIRNEW_BDLNEWDIRBOG   
				,'''|| @DATAFILE || '''
				, CURRENT_DATE
				,'|| @LOTE || '
			
						 
             )				
    
				;'
	       END         
       
     TO OPERATOR (OPERATOR_130 [1])
     SELECT * FROM OPERATOR (FEXP_OPERATOR);      
    );
	   
	
	
	STEP Update_Table_MaxID
       (
        APPLY
            
			('UPDATE '|| @BDMTDAT ||'.MAX_ID
               SET    ID = (SELECT COALESCE(MAX(Cod_DW_Ubic_Nomenc),0) FROM '||@BDDATOS||'.'||@TablaDestino1||')
               WHERE  Nombre_Tabla = '''||@TablaDestino1||'''
               ;')
         TO OPERATOR (DDL_OPERATOR);
       );

);     
