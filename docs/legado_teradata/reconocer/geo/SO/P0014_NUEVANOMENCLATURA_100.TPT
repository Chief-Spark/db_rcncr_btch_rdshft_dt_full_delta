DEFINE JOB CARGAR_NUEVANOMENCLATURA
DESCRIPTION 'CARGA NUEVANOMENCLATURA DESDE ARCHIVO PLANO'
(
    DEFINE SCHEMA NUEVANOMENCLATURA_SCHEMA
    DESCRIPTION 'NUEVANOMENCLATURA SCHEMA' 
    (
      AVENIDA_BDLNEWDIRBOG VARCHAR(2)
	  ,NUMCOD_BDLNEWDIRBOG VARCHAR(60)
	  ,DIRORI_BDLNEWDIRBOG VARCHAR(60)
	  ,DIRNEW_BDLNEWDIRBOG VARCHAR(60)
	  

 	 
    );

    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
	 ,VARCHAR AccountID
     ,VARCHAR ARRAY ErrorList = ['3803','3807']
    );

    DEFINE OPERATOR LOAD_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER LOAD OPERATOR'
    TYPE UPDATE 
    SCHEMA NUEVANOMENCLATURA_SCHEMA
    ATTRIBUTES
    (
      INTEGER MaxSessions  = 64,                     
      INTEGER MinSessions  = 1,                      
      INTEGER ErrorLimit   = 1,                      
      VARCHAR TargetTable  = @BDSTAGE||'.'||@LAYOUT||'_'||@HOY,  
      VARCHAR UserName     = @UserName,      
      VARCHAR UserPassword = @UserPassword,  
      VARCHAR TdpId        = @TdpId,                
      VARCHAR AccountId,                             
      VARCHAR WorkTable    = @BDTEMPO||'.'||@Wktb,     
      VARCHAR ErrorTable1  = @BDTEMPO||'.'||@Err1,     
      VARCHAR ErrorTable2  = @BDTEMPO||'.'||@Err2,     
      VARCHAR LogTable     = @BDTEMPO||'.'||@LogTable,
	  INTEGER TenacityHours ,
	  INTEGER TenacitySleep 
    );  

    DEFINE OPERATOR FILE_READER
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DATA CONNECTOR OPERATOR'
    TYPE DATACONNECTOR PRODUCER
    SCHEMA NUEVANOMENCLATURA_SCHEMA
    ATTRIBUTES
    (
      VARCHAR DirectoryPath   = @ENTRADAS,         
      VARCHAR FileName        = @DATAFILE, 
      /*VARCHAR MultipleReaders = 'Y',*/
      VARCHAR IndicatorMode   = 'N',               
      VARCHAR OpenMode        = 'Read',            
      VARCHAR Format          = 'Delimited',       
      VARCHAR TextDelimiter   = '|'               
    );

    STEP setup_tables  
    ( 
     APPLY  
           ('DROP TABLE '||@BDSTAGE||'.'||@LAYOUT||'_'||@HOY||';'),       
		   ('DROP TABLE '||@BDTEMPO||'.'||@Wktb||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err1||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err2||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@LogTable||';') 
      TO OPERATOR (DDL_OPERATOR );
    );

    STEP create_Stg
    (      
      APPLY 
            ('CREATE MULTISET TABLE '||@BDSTAGE||'.'||@LAYOUT||'_'||@HOY||',
                     
              NO BEFORE JOURNAL,  
              NO AFTER JOURNAL,   
              CHECKSUM = DEFAULT 
              (
                AVENIDA_BDLNEWDIRBOG VARCHAR(2)  NULL
				,NUMCOD_BDLNEWDIRBOG VARCHAR(60) NULL 
				,DIRORI_BDLNEWDIRBOG VARCHAR(60) NULL
				,DIRNEW_BDLNEWDIRBOG VARCHAR(60) NULL
				
				
						 
              )
              PRIMARY INDEX ( AVENIDA_BDLNEWDIRBOG,NUMCOD_BDLNEWDIRBOG );
           ')
     
	

            ,('CREATE MULTISET TABLE '||@BDSTAGE||'.'||@LAYOUT||'_IN,
                     
              NO BEFORE JOURNAL,  
              NO AFTER JOURNAL,   
              CHECKSUM = DEFAULT 
              (
			  
					   AVENIDA_BDLNEWDIRBOG 	VARCHAR(2) NULL
					  ,NUMCOD_BDLNEWDIRBOG 		VARCHAR(60) NULL 
					  ,DIRORI_BDLNEWDIRBOG 		VARCHAR(60) NULL
					  ,DIRNEW_BDLNEWDIRBOG		VARCHAR(60) NULL
					  ,NOMBRE_ARCHIVO_PLANO		VARCHAR (100)
					  ,FECHA_CARGA 				DATE
					  ,Cod_DW_Ubic_Nomenc 		BIGINT /*#1*/
					  ,Cod_DW_Ubic_Act	  		BIGINT /*#1*/
					  ,Cod_DW_Ubic		  		BIGINT /*#1*/
					  ,LOTE   			  		INTEGER
					  ,SEVERIDAD		  		INTEGER
					 ,COD_RECHAZO		  		VARCHAR (50)

                 
              )
             PRIMARY INDEX ( AVENIDA_BDLNEWDIRBOG,NUMCOD_BDLNEWDIRBOG );
           ')
    
	,('CREATE MULTISET TABLE '||@BDSTAGE||'.'||@LAYOUT||'_DUP,
                     
              NO BEFORE JOURNAL,  
              NO AFTER JOURNAL,   
              CHECKSUM = DEFAULT 
              (
                AVENIDA_BDLNEWDIRBOG   VARCHAR(2)   NULL
				,NUMCOD_BDLNEWDIRBOG   VARCHAR(60)  NULL
				,DIRORI_BDLNEWDIRBOG   VARCHAR(60)  NULL
				,DIRNEW_BDLNEWDIRBOG   VARCHAR(60)  NULL
				,NOMBRE_ARCHIVO_PLANO  VARCHAR (100)
				,FECHA_CARGA       	   DATE 
				,LOTE  				   INTEGER 		
						 
              )
              PRIMARY INDEX ( AVENIDA_BDLNEWDIRBOG,NUMCOD_BDLNEWDIRBOG );
           ')
	
	
	
	  TO OPERATOR (DDL_OPERATOR );
    );

    STEP load_data_from_file
    (
      APPLY  
           ('INSERT INTO  '||@BDSTAGE||'.'||@LAYOUT||'_'||@HOY||' 
             VALUES 
                   ( 
					  :AVENIDA_BDLNEWDIRBOG
					  ,:NUMCOD_BDLNEWDIRBOG
					  ,:DIRORI_BDLNEWDIRBOG
					  ,:DIRNEW_BDLNEWDIRBOG
					 
                   );
           ')
      TO OPERATOR ( LOAD_OPERATOR [1] )
      SELECT * FROM OPERATOR ( FILE_READER [1] );
    );
);
