DEFINE JOB P0007_PUNTO_DE_INTERES_GEO_130
DESCRIPTION 'Paso del Proceso de carga sobre tabla final "PUNTO_DE_INTERES_GEO" a partir de la vista VSTG_CargaPUNTO_DE_INTERES_GEO Paso 130'
(  
DEFINE SCHEMA PUNTO_DE_INTERES_GEO
    DESCRIPTION 'Schema Estructura de la Vista'
    ( 
			 IN_Cod_DW_Punto_Interes INTEGER 
			,IN_Cod_Punto_Interes_Host INTEGER
			,IN_Nombre VARCHAR (200)
			,IN_Latitud  VARCHAR (50)
			,IN_Longitud VARCHAR (50)
			,IN_Cod_DW_Tipo_Punto_Interes INTEGER
			,IN_Departamento_Esri VARCHAR (50)
			,IN_Municipio_Esri VARCHAR (50)
			,IN_SEVERIDAD BYTEINT 
			,IN_COD_RECHAZO VARCHAR (30)
			,IN_Fecha_Actualizacion ANSIDATE
			,IN_Usuario_BD VARCHAR (30)
			,IN_OBJECTID INTEGER
			,IN_POI_ID INTEGER
			,IN_CAT_ID VARCHAR (20)
			,IN_POI_NAME VARCHAR (200)
			,IN_Descripcion_CAT_ID VARCHAR (50)
			,IN_Municipio VARCHAR (50)
			,IN_Departamento VARCHAR (50)
			,IN_POINT_X VARCHAR (50)
			,IN_POINT_Y VARCHAR (50)      
    );    


    /* ================================================================
       Definición del Operador "Fexp" (Vista)
       ================================================================ */
    
    DEFINE OPERATOR FEXP_OPERATOR 
    TYPE EXPORT                   
    SCHEMA PUNTO_DE_INTERES_GEO            
    ATTRIBUTES                    
    (                          
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
     ,INTEGER MaxSessions                   
     ,INTEGER MinSessions                   
     ,VARCHAR AccountID                                    
     ,VARCHAR PrivateLogName                               
     ,VARCHAR TraceLevel                                   
     ,VARCHAR WorkingDatabase                              
     ,VARCHAR ErrorTable   = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours 
     ,INTEGER TenacitySleep 
     ,VARCHAR SelectStmt    = 'SELECT * FROM  '||@BDSTAGE||'.VSTGCargaPuntoInteresGEO;');
	
    /* ================================================================
       Definición de (Tabla(s) Destino)
       ================================================================  */
    
    DEFINE OPERATOR OPERATOR_130
    DESCRIPTION 'TERADATA WAREHOUSE BUILDER UPDATE OPERATOR'
    TYPE UPDATE 
	 SCHEMA PUNTO_DE_INTERES_GEO   
    ATTRIBUTES  
    (                             /* Si son varias: VARCHAR ARRAY TargetTable = ['Trans','Accounts','Customer'] */ 
      VARCHAR UserName          = @UserName     
     ,VARCHAR UserPassword      = @UserPassword 
     ,VARCHAR TdpId             = @TdpId        
     ,VARCHAR AccountId         
							


	 ,VARCHAR ARRAY TargetTable = [@BDDATOS ||'.'||@TablaDestino1 ,@BDSTAGE ||'.'||@LAYOUT||'_IN',@BDSTAGE ||'.'||@LAYOUT||'_DUP']  		 							
     ,VARCHAR ARRAY ErrorTable1 = [@BDTEMPO ||'.'||@Wktb 		  ,	@BDTEMPO||'.'||@Wktb||'_IN' ,	@BDTEMPO||'.'||@Wktb||'_DUP']  
     ,VARCHAR ARRAY ErrorTable2 = [@BDTEMPO ||'.'||@Err1 		  ,	@BDTEMPO||'.'||@Err1||'_IN' ,	@BDTEMPO||'.'||@Err1||'_DUP']  
     ,VARCHAR ARRAY WorkTable   = [@BDTEMPO ||'.'||@Err2 		  ,	@BDTEMPO||'.'||@Err2||'_IN' ,	@BDTEMPO||'.'||@Err2||'_DUP']  
	 
	
     ,VARCHAR LogTable     = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours 
     ,INTEGER TenacitySleep 
    );
    
    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
       (
        VARCHAR UserName = @UserName,
        VARCHAR UserPassword = @UserPassword,
        VARCHAR TdpId = @TdpId,
        VARCHAR ARRAY ErrorList = ['3803','3807','5978']
       );

	
	
	
    /* ====================================================================
        Apply Upsert Usando Mload Desde lo que entregó el Fexp
       ====================================================================  */
    
    STEP Load_PUNTO_DE_INTERES_GEO
    (             
     APPLY        
           CASE   
                WHEN ( IN_Severidad = 1  ) /*  Upsert  */
                THEN (
                        'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'
                         SET     
                                LOTE_ACTUALIZACION    	=  ' || @LOTE ||'
								
					   ,Departamento_Esri		=  :IN_Departamento_Esri
					   ,Municipio_Esri 			=  :IN_Municipio_Esri
					   ,Fecha_Actualizacion 	=  CURRENT_DATE	

                         WHERE   
                                 Cod_DW_Punto_Interes      = :IN_Cod_DW_Punto_Interes;
                        '	
                       ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino1||' 
                            (	 
					  
									Cod_DW_Punto_Interes
									,Cod_Punto_Interes_Host
									,Nombre
									,Latitud
									,Longitud
									,Cod_DW_Tipo_Punto_Interes
									,Departamento_Esri
									,Municipio_Esri
									,Lote
									,Severidad
									,Usuario_BD
									,Fecha_Actualizacion
                          	  )
                          VALUES
                             (  
									 :IN_Cod_DW_Punto_Interes
									,:IN_Cod_Punto_Interes_Host
									,:IN_Nombre
									,CAST(:IN_Latitud AS DECIMAL(38,8)) 
									,CAST(:IN_Longitud AS DECIMAL(38,8))
									,:IN_Cod_DW_Tipo_Punto_Interes
									,:IN_Departamento_Esri
									,:IN_Municipio_Esri
									,' || @LOTE || '
									,:IN_Severidad
									,:IN_Usuario_BD
									,:IN_Fecha_Actualizacion
							 
                           	  );'
                   			                     
                
				    )
				INSERT FOR MISSING UPDATE ROWS
            END,

           CASE WHEN ( IN_Severidad = 2 or IN_Severidad = 3)  /* Upsert a Rechazados */
                THEN 
                     (
                      'INSERT INTO ' ||@BDSTAGE||'.'||@LAYOUT||'_IN
                               ( 
                                 
								OBJECTID					
								,POI_ID					
								,CAT_ID                 
								,POI_NAME               
								,Descripcion_CAT_ID     
								,Municipio              
								,Departamento           
								,POINT_X                
								,POINT_Y                
								,NOMBRE_ARCHIVO_PLANO	
								,FECHA_CARGA 			
								,Cod_DW_Punto_Interes	
								,LOTE 					
								,SEVERIDAD				
								,COD_RECHAZO			
 
                               )                      
                       VALUES                         
                               (  

								:IN_OBJECTID				
					           ,:IN_POI_ID					
							   ,:IN_CAT_ID                 
							   ,:IN_POI_NAME               
							   ,:IN_Descripcion_CAT_ID     
							   ,:IN_Municipio              
							   ,:IN_Departamento           
							   ,CAST(:IN_POINT_X AS DECIMAL(38,8))
							   ,CAST(:IN_POINT_Y AS DECIMAL(38,8))
							   ,'''|| @DATAFILE || '''	
							   , CURRENT_DATE			
                               ,:IN_Cod_DW_Punto_Interes	
                               ,'|| @LOTE || '  					
                               ,:IN_SEVERIDAD				
                               ,:IN_COD_RECHAZO			
							      
                               )                      
                       ;'                             
                     )
           END ,
		   
		   CASE WHEN ( IN_Severidad = 5 ) /* Upsert a Rechazados */
                THEN 
		   
		   'INSERT INTO ' ||@BDSTAGE||'.'||@LAYOUT||'_DUP
              (
          
					OBJECTID
					,POI_ID
					,CAT_ID
					,POI_NAME
					,Descripcion_CAT_ID
					,Municipio
					,Departamento
					,POINT_X
					,POINT_Y
					,NOMBRE_ARCHIVO_PLANO
				    ,FECHA_CARGA
					,LOTE
					
				 
					)
				VALUES
				(
					:IN_OBJECTID
					,:IN_POI_ID
					,:IN_CAT_ID
					,:IN_POI_NAME
					,:IN_Descripcion_CAT_ID
					,:IN_Municipio
					,:IN_Departamento
					,CAST(:IN_POINT_X AS DECIMAL(38,8)) 
					,CAST(:IN_POINT_Y AS DECIMAL(38,8))
					,'''|| @DATAFILE || '''
				    , CURRENT_DATE
					,'|| @LOTE || '
				)
		   		                      
                       ;'                             
                     
           END         
       
     TO OPERATOR (OPERATOR_130 [1])
     SELECT * FROM OPERATOR (FEXP_OPERATOR);      
    );
		   
	
	
	STEP Update_Table_MaxID
       (
        APPLY
            
		 ('UPDATE '|| @BDMTDAT ||'.MAX_ID
               SET    ID = (SELECT COALESCE(MAX(Cod_DW_Punto_Interes),0) FROM '||@BDDATOS||'.'||@TablaDestino1||')
               WHERE  Nombre_Tabla = '''||@TablaDestino1||'''
               ;')
         TO OPERATOR (DDL_OPERATOR);
       );

);     
