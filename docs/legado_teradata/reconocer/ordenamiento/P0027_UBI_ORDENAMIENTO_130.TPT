DEFINE JOB P0027_UBI_ORDENAMIENTO_130
DESCRIPTION 'Paso del Proceso de Update sobre tabla final RELACION_PERSONA_UBICACION'
(  
DEFINE SCHEMA UBI_ORDENAMIENTO
    DESCRIPTION 'Schema Estructura VstgUBI_ORDENAMIENTO'
    
	(  
	   IN_Cod_Pin_Persona INTEGER
      ,IN_Id_Buro_Persona INTEGER
      ,IN_Cod_DW_Persona_Ubic BIGINT /*#1*/
      ,IN_Lugar INTEGER
      ,IN_SEVERIDAD_UPDATE INTEGER
      ,IN_SEVERIDAD INTEGER
	  ,IN_Orden_Prioridad INTEGER   
	  
    );    


    /* ================================================================
       Definición del Operador "Fexp" (Vista)
       ================================================================ */
    
    DEFINE OPERATOR FEXP_OPERATOR 
    TYPE EXPORT                   
    SCHEMA UBI_ORDENAMIENTO            
    ATTRIBUTES                    
    (                          
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
     ,INTEGER MaxSessions                   
     ,INTEGER MinSessions                   
     ,VARCHAR AccountID                                    
     ,VARCHAR PrivateLogName                               
     ,VARCHAR TraceLevel                                   
     ,VARCHAR WorkingDatabase                              
     ,VARCHAR ErrorTable   = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours = @TenacityHours
     ,INTEGER TenacitySleep = @TenacitySleep
	 ,VARCHAR SelectStmt    = 'SELECT * FROM  '||@BDSTAGE||'.VstgUBI_ORDENAMIENTO;'
    );
	
    /* ================================================================
       Definición de (Tabla(s) Destino)
       ================================================================  */
    
    DEFINE OPERATOR OPERATOR_130
    DESCRIPTION 'TERADATA WAREHOUSE BUILDER UPDATE OPERATOR'
    TYPE UPDATE 
	 SCHEMA UBI_ORDENAMIENTO   
    ATTRIBUTES  
    (                             /* Si son varias: VARCHAR ARRAY TargetTable = ['Trans','Accounts','Customer'] */ 
      VARCHAR UserName          = @UserName     
     ,VARCHAR UserPassword      = @UserPassword 
     ,VARCHAR TdpId             = @TdpId        
     ,VARCHAR AccountId                         
     	 
                                                              
     ,VARCHAR ARRAY TargetTable = [@BDDATOS ||'.'||@TablaDestino1] 	
	 ,VARCHAR ARRAY ErrorTable1 = [@BDTEMPO ||'.'||@Wktb ]  
     ,VARCHAR ARRAY ErrorTable2 = [@BDTEMPO ||'.'||@Err1 ]  
     ,VARCHAR ARRAY WorkTable   = [@BDTEMPO ||'.'||@Err2 ] 
	 
	 
	 ,VARCHAR LogTable          =  @BDTEMPO ||'.'||@LogTable 
     ,INTEGER TenacityHours = @TenacityHours
     ,INTEGER TenacitySleep = @TenacitySleep 
    );
    

	 DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
       (
        VARCHAR UserName = @UserName,
        VARCHAR UserPassword = @UserPassword,
        VARCHAR TdpId = @TdpId,
        VARCHAR ARRAY ErrorList = ['3803','3807','5978']
       );
	
    /* ====================================================================
        Apply Upsert Usando Mload Desde lo que entregó el Fexp
       ====================================================================  */
    
  STEP Load_RELACION_PERSONA_UBICACION
    (             
     APPLY   
		   CASE   
              WHEN ( IN_Severidad_update = 1 )                          
              THEN (	 
			/*1. se actualiza el orden prioridad a Nulo cuando el id_buro_persona para volver a marcar el ordenamiento */
					'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'
                        SET     
							LOTE_ACTUALIZACION    			='|| @LOTE ||'
						   ,Fecha_Modificacion 				= CURRENT_DATE
						   ,Fecha_Ult_Ordenamiento		    = CURRENT_DATE
						   ,Orden_Prioridad_Anterior		= :IN_Orden_Prioridad
						   
						WHERE 
						
                             Cod_DW_Persona_Ubic = :IN_Cod_DW_Persona_Ubic;
                       '	
					                             
                       )		                     
                IGNORE MISSING UPDATE ROWS
		  END				
		  ,CASE   
              WHEN ( IN_Severidad = 1)                          
              THEN (	 
					/*se actualiza el orden prioridad al valor del orden*/
					'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'
                        SET     
							LOTE_ACTUALIZACION    			='|| @LOTE ||'
						   ,Fecha_Modificacion 				= CURRENT_DATE
						   ,Orden_Prioridad					= :IN_Lugar	
						   
						WHERE   
                             
							 Cod_DW_Persona_Ubic = :IN_Cod_DW_Persona_Ubic;
                       '					                             
                       )
					   
                IGNORE MISSING UPDATE ROWS
			 END			
			 		 
     TO OPERATOR (OPERATOR_130 [1])
     SELECT * FROM OPERATOR (FEXP_OPERATOR);      
    );

	
	STEP Update_Table_MaxID
   (
	APPLY
		
		 ('UPDATE '||@BDMTDAT ||'.'||'CONTROL_ORDENAMIENTO'||'
		   SET 	 Fecha_Ult_Ord = CURRENT_TIMESTAMP(6) ;
			')
	 TO OPERATOR (DDL_OPERATOR);
   );
	
	
	
);     
