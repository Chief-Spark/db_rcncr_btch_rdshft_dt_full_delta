DEFINE JOB Job_CalcularIndicadorMovilidad
DESCRIPTION 'CREACION VISTA MEDIANTE OPERADOR DDL'
(
    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName        = @UserName,      
      VARCHAR UserPassword    = @UserPassword,   
      VARCHAR TdpId           = @TdpId,          
      VARCHAR AccountID,                         
      VARCHAR ARRAY ErrorList = ['3803','3807','2574','2580','2572'] 
    );
STEP DROP_RELEASE_TABLES  
    (           
      APPLY     
           ('DROP TABLE '||@BDTEMPO||'.'||@Wktb||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err1||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err2||';'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Wktb||'2;'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Err1||'2;'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Err2||'2;'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Wktb||'3;'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Err1||'3;'),
		   ('DROP TABLE '||@BDTEMPO||'.'||@Err2||'3;'),
		   
		   
		   
           ('DROP TABLE '||@BDTEMPO||'.'||@LogTable||';'),
		   ('RELEASE MLOAD ' || @BDDATOS || '.'||@TablaDestino1 ||';'),
		   ('RELEASE MLOAD ' || @BDDATOS || '.'||@TablaDestino1 ||' in apply;'),
		   ('RELEASE MLOAD ' || @BDSTAGE || '.'||@LAYOUT||'_IN ;'),
		   ('RELEASE MLOAD ' || @BDSTAGE || '.'||@LAYOUT||'_IN  in apply;'),
		   ('RELEASE MLOAD ' || @BDSTAGE || '.'||@LAYOUT||'_DUP ;'),
		   ('RELEASE MLOAD ' || @BDSTAGE || '.'||@LAYOUT||'_DUP in apply;'),
		   
		   
		   
		    (
		       'CREATE SET TABLE ' || @BDSTAGE || '.'||@LAYOUT||'_IN  ,FALLBACK , '  
		    || 'NO BEFORE JOURNAL, NO AFTER JOURNAL, CHECKSUM = DEFAULT, DEFAULT MERGEBLOCKRATIO '
		    || '( Cod_DW_Persona_Ind_Movil INTEGER NOT NULL, '
		    || ' Id_Buro_Persona INTEGER, '
		    || ' Cod_Pin_Persona INTEGER, '
		    || ' Fecha_Inicio DATE, '
		    || ' Fecha_Eliminado DATE, '
		    || ' Cod_DW_Indicador_Movilidad INTEGER, '
		    || ' Fecha_Modificacion DATE, ' 
		    || ' Lote INTEGER, '
		    || ' Lote_Actualizacion INTEGER, '
		    || ' Usuario_BD VARCHAR(20), '
		    || ' Severidad INTEGER, '
		    || ' Cod_Rechazo VARCHAR(50) ) '
		    || 'PRIMARY INDEX ( Cod_DW_Persona_Ind_Movil ) ; '
			),
		   


		    (
		       'CREATE SET TABLE ' || @BDSTAGE || '.'||@LAYOUT||'_DUP  ,FALLBACK , '  
		    || 'NO BEFORE JOURNAL, NO AFTER JOURNAL, CHECKSUM = DEFAULT, DEFAULT MERGEBLOCKRATIO '
		    || '( Cod_DW_Persona_Ind_Movil INTEGER NOT NULL, '
		    || ' Id_Buro_Persona INTEGER, '
		    || ' Cod_Pin_Persona INTEGER, '
		    || ' Fecha_Inicio DATE, '
		    || ' Fecha_Eliminado DATE, '
		    || ' Cod_DW_Indicador_Movilidad INTEGER, '
		    || ' Fecha_Modificacion DATE, ' 
		    || ' Lote INTEGER, '
		    || ' Lote_Actualizacion INTEGER, '
		    || ' Usuario_BD VARCHAR(20), '
		    || ' Severidad INTEGER, '
		    || ' Cod_Rechazo VARCHAR(50) ) '
		    || 'PRIMARY INDEX ( Cod_DW_Persona_Ind_Movil ) ; '
			)


		   
      TO OPERATOR ( DDL_OPERATOR );                       
    );
  
);
