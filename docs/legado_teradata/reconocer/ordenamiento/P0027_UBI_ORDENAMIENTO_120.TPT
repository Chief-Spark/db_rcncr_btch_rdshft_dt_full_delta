DEFINE JOB RELEASE_FECHA_REPORTE 
DESCRIPTION 'BORRADO TABLAS DE TRABAJO'
(
    DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName        = @UserName,      
      VARCHAR UserPassword    = @UserPassword,   
      VARCHAR TdpId           = @TdpId,          
      VARCHAR AccountID,                         
      VARCHAR ARRAY ErrorList = ['3803','3807','2574','2580','2572'] 
    );
STEP DROP_RELEASE_TABLES  
    (           
      APPLY      
           ('DROP TABLE '||@BDTEMPO||'.'||@Wktb||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err1||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@Err2||';'),
           ('DROP TABLE '||@BDTEMPO||'.'||@LogTable||';'),		   
		   ('RELEASE MLOAD '|| @BDDATOS || '.'||@TablaDestino1 ||';'),  
		   ('RELEASE MLOAD '|| @BDDATOS || '.'||@TablaDestino1 ||' in apply;')
		   
      TO OPERATOR ( DDL_OPERATOR );                       
    );
  
);
