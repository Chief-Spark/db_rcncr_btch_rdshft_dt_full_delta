# Objetivo:          Carga sobre las tablas finales UNIFICACION_DIRECCION, REPORTE_UNIFICACION_DIRECCION
#                    DIRECCION_FISICA y RELACION_PERSONA_UBICACION 
# Fecha:	     2017-01-18
# Realizado por:     Carlos Castillo
# PARAMETROS:	TablaDestino1 = 'UNIFICACION_DIRECCION',
#				TablaDestino2 = 'REPORTE_UNIFICACION_DIRECCION',
#				TablaDestino3 = 'DIRECCION_FISICA',
#				TablaDestino4 = 'RELACION_PERSONA_UBICACION',
#
#
# Proyecto: 	     Experian Reconocer	
# Script:	     P0020_UNIFICACION_DIRECCION
#
# BITACORA
# -----------------------------------------------------------------------------------------
#  Fecha		Objetivo										Realizado por
# 2017-08-09	#1_act se cambia la condicion por NULL 			Carlos Castillo
#				#en dirección
# 2018-03-13    #2 Add Cod_Pin_Persona							Carlos Castillo
# 2018-03-13    #3 Ajuste tipo dato BIGINT						Carlos Castillo
# 2018-09-14    #4 Ajuste indice REPORTE_UNIFICACION_DIRECCION	Carlos Castillo
# -----------------------------------------------------------------------------------------
