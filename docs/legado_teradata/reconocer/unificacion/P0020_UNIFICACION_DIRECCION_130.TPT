*/



DEFINE JOB Carga_UNIFICACION_R2
DESCRIPTION 'Cargar datos a tablas UNIFICACION_DIRECCION, REPORTE_UNIFICACION_DIRECCION,RELACION_PERSONA_UBICACION y DIRECCION_FISICA'
(  
DEFINE SCHEMA VstgCargaUnificacionDir
    DESCRIPTION 'Schema Estructura de la Vista'
    (  	IN_Cod_DW_Persona_Ubic				  BIGINT	/*#3*/
		,IN_Cod_DW_Direccion_Unificada		  BIGINT 	/*#3*/
		,IN_Unifica_Atributos				  INTEGER
		,IN_Fecha_Unificacion				  ANSIDATE 
		,IN_Id_Buro_Persona					  INTEGER
		,IN_Cod_DW_Ubic						  BIGINT    /*#3*/
		,IN_Complemento     				  VARCHAR(100) 
		,IN_Cod_DW_Direccion_Fisica			  BIGINT	/*#3*/              	       	              		       	              	       
		,IN_Cod_DW_Tipo_Ubicacion_Dir		  INTEGER						
		,IN_Severidad_UD					  BYTEINT						
		,IN_ID_ACTUALIZACION				  BYTEINT						
		,IN_Cod_Pin_Persona					  INTEGER
		,IN_SEVERIDAD_DIR_FISICA 			  INTEGER /*#4*/
		,IN_Tipo_Via_Principal 				  VARCHAR(20) /*#4*/
		,IN_Via_Principal 					  VARCHAR(100) /*#4*/
		,IN_Via_Generadora 					  INTEGER /*#4*/
		,IN_Numero_Puerta 					  INTEGER /*#4*/


    );    


    /* ================================================================
       Definicion del Operador "Fexp" (Vista)
       ================================================================ */
    
    DEFINE OPERATOR FEXP_OPERATOR 
    TYPE EXPORT                   
    SCHEMA VstgCargaUnificacionDir            
    ATTRIBUTES                    
    (                          
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
     ,VARCHAR ErrorTable   = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours = @TenacityHours 
     ,INTEGER TenacitySleep = @TenacitySleep 
     ,VARCHAR SelectStmt    = 'SELECT * FROM  '||@BDSTAGE||'.VstgCargaUnificacionDir;'
    );
  
    /* ================================================================
       Definicion de (Tabla(s) Destino)
       ================================================================  */
    
    DEFINE OPERATOR OPERATOR_130
    DESCRIPTION 'TERADATA WAREHOUSE BUILDER UPDATE OPERATOR'
    TYPE UPDATE 
   SCHEMA VstgCargaUnificacionDir   
    ATTRIBUTES  
    (
      VARCHAR UserName          = @UserName     
     ,VARCHAR UserPassword      = @UserPassword 
     ,VARCHAR TdpId             = @TdpId        
     ,VARCHAR ARRAY TargetTable  = [@BDDATOS ||'.'||@TablaDestino1 ,@BDDATOS||'.'||@TablaDestino2, @BDDATOS||'.'||@TablaDestino3, @BDDATOS||'.'||@TablaDestino4] 
     ,VARCHAR ARRAY WorkTable    = [@BDTEMPO ||'.'||@Wktb          ,@BDTEMPO||'.'||@Wktb||'_4'   , @BDTEMPO||'.'||@Wktb||'_7'   , @BDTEMPO||'.'||@Wktb||'_10'   ]  
     ,VARCHAR ARRAY ErrorTable1  = [@BDTEMPO ||'.'||@Err1          ,@BDTEMPO||'.'||@Err1||'_5'   , @BDTEMPO||'.'||@Err1||'_8'   , @BDTEMPO||'.'||@Err1||'_11'   ]   
     ,VARCHAR ARRAY ErrorTable2  = [@BDTEMPO ||'.'||@Err2          ,@BDTEMPO||'.'||@Err2||'_6'   , @BDTEMPO||'.'||@Err2||'_9'   , @BDTEMPO||'.'||@Err2||'_12'   ]       
     ,VARCHAR LogTable      = @BDTEMPO||'.'||@LogTable
     ,INTEGER TenacityHours = @TenacityHours
     ,INTEGER TenacitySleep = @TenacitySleep                                                                      
    );
                           
      DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName     = @UserName      
     ,VARCHAR UserPassword = @UserPassword  
     ,VARCHAR TdpId        = @TdpId         
    );
  
    /* ====================================================================
        Apply Upsert Usando Mload Desde lo que entrega el Fexp
       ====================================================================  */
    
    STEP Load_UNIFICACION_DIRECCION
    (             
     APPLY                                                 
      CASE  WHEN ( IN_Severidad_UD < 3 )                          /*  Upsert UNIFICACION_DIRECCION  */
        THEN (  'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'

            	 SET Lote_Actualizacion    					= '|| @LOTE ||'
            	    ,Usuario_BD 		   					= USER
            	    ,Fecha_Modificacion    					= CURRENT_DATE
            	    WHERE Cod_DW_Persona_Ubic 				= :IN_Cod_DW_Persona_Ubic 
					 AND Cod_DW_Direccion_Unificada			= :IN_Cod_DW_Direccion_Unificada	
					;'

		 ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino1||' 
		 (   
			Cod_DW_Persona_Ubic       
			,Cod_DW_Direccion_Unificada
			,Unifica_Atributos         
			,Fecha_Unificacion         
			,Lote                      
			,Severidad                 
			,Usuario_BD                
		   ) VALUES
            ( :IN_Cod_DW_Persona_Ubic       
			,:IN_Cod_DW_Direccion_Unificada
			,:IN_Unifica_Atributos         
			,:IN_Fecha_Unificacion         
			,'||@LOTE||'                     
			,:IN_Severidad_UD                 
			,USER                
		);'
                                             
                
            )
            INSERT FOR MISSING UPDATE ROWS /* INSERTA LOS REGISTROS QUE NO SE IDENTIFICARON EN EL UPDATE */
      END
    ,CASE WHEN ( IN_Severidad_UD < 3  )                          /*  Upsert   */
                THEN ('UPDATE '||@BDDATOS ||'.'||@TablaDestino2||'
                       SET Lote_Actualizacion    =  '||@LOTE||'
			   ,Fecha_Unificacion   = :IN_Fecha_Unificacion
			   ,Usuario_BD 	        = USER
			   ,Fecha_Modificacion 	= CURRENT_DATE
		        WHERE Cod_DW_Persona_Ubic 				= :IN_Cod_DW_Persona_Ubic 
				 AND Cod_DW_Direccion_Unificada			= :IN_Cod_DW_Direccion_Unificada
				 AND Fecha_Inicio_Dato					= :IN_Fecha_Unificacion /*#4*/
		       ;'  
                     ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino2||'        
                         (Cod_DW_Direccion_Unificada    
				,Unifica_Atributos             
				,Fecha_Unificacion             
				,Lote                                  
				,Severidad                     
				,Usuario_BD                    
				,Cod_DW_Persona_Ubic           
				,Fecha_Inicio_Dato             
				)
			VALUES
				(:IN_Cod_DW_Direccion_Unificada    
				 ,:IN_Unifica_Atributos             
				 ,:IN_Fecha_Unificacion             
				 ,'||@LOTE||'                          
				 ,:IN_Severidad_UD                     
				 ,USER                    
				 ,:IN_Cod_DW_Persona_Ubic           
				 ,:IN_Fecha_Unificacion             	                 
			);'
          )
        INSERT FOR MISSING UPDATE ROWS
    END 
    
	
	
	
    ,CASE WHEN ( 	 IN_Complemento IS NOT NULL AND IN_Severidad_UD = 3 
				 AND IN_Cod_DW_Direccion_Fisica IS NOT NULL 
				 AND IN_ID_ACTUALIZACION=1 
				 AND IN_SEVERIDAD_DIR_FISICA = 1) /*#4*/
				 
              THEN ( 'UPDATE '||@BDDATOS ||'.'||@TablaDestino3||'
                      SET LOTE_ACTUALIZACION  =  '|| @LOTE ||'
                      	  ,Fecha_Modificacion  = :IN_Fecha_Unificacion
                           WHERE Cod_DW_Direccion_Fisica      = :IN_Cod_DW_Direccion_Fisica
                           ;'
                     ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino3||'
                        (Cod_DW_Direccion_Fisica
			,Complemento
			,Tipo_Via_Principal
			,Via_Principal
			,Via_Generadora
			,Numero_Puerta
			,Lote
			,Lote_Actualizacion
			,Severidad
			,Usuario_BD
			,Generada_Enriquecida
			,Fecha_Inactivacion
			,Cod_DW_Ubic
			,Fecha_Modificacion)
		VALUES
			(:IN_Cod_DW_Direccion_Fisica
			,:IN_Complemento			
			,:IN_Tipo_Via_Principal		/*#4*/
			,:IN_Via_Principal			/*#4*/
			,:IN_Via_Generadora			/*#4*/
			,:IN_Numero_Puerta			/*#4*/
			,'||@LOTE||'
			,NULL
			,1
			,USER
			,1
			,NULL
			,:IN_Cod_DW_Ubic
			,:IN_Fecha_Unificacion
                        );'
                                                )
         INSERT FOR MISSING UPDATE ROWS
     END
     
	 /* RELACION_PERSONA_UBICACION */
     ,CASE WHEN ( IN_Complemento IS NOT NULL AND IN_Severidad_UD = 3 AND IN_Cod_DW_Direccion_Fisica IS NOT NULL AND IN_ID_ACTUALIZACION=1 )
              THEN ('UPDATE '||@BDDATOS ||'.'||@TablaDestino4||'
                      SET LOTE_ACTUALIZACION   =  '|| @LOTE ||'
                      		,Fecha_Relacion_Persona_Ubicaci  = :IN_Fecha_Unificacion
                                ,Fecha_Modificacion              = :IN_Fecha_Unificacion
                     WHERE Cod_DW_Persona_Ubic      = :IN_Cod_DW_Persona_Ubic
                     ;'
                   ,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino4||'
                      (Cod_DW_Persona_Ubic
			,Id_Buro_Persona
			,Fecha_Relacion_Persona_Ubicaci
			,Lote
			,Lote_Actualizacion
			,Severidad
			,Usuario_BD
			,Fecha_Modificacion
			,Orden_Prioridad
			,Cod_DW_Telefono
			,Cod_DW_Direccion_Electronica
			,Cod_DW_Direccion_Fisica
			,Cod_DW_Tipo_Ubicacion_Dir
			,Ind_Unificacion
			,Cod_DW_Ubic
			,Cod_Pin_Persona
			)
            VALUES
             (:IN_Cod_DW_Persona_Ubic
             ,:IN_Id_Buro_Persona
             ,:IN_Fecha_Unificacion
             ,'||@LOTE||'
             ,NULL
             ,1
			 ,USER
			 ,:IN_Fecha_Unificacion
			 ,Null
			 ,-1	/*#4*/
			 ,-1	/*#4*/
			 ,:IN_Cod_DW_Direccion_Fisica
			 ,:IN_Cod_DW_Tipo_Ubicacion_Dir
			 ,Null
			 ,:IN_Cod_DW_Ubic
             ,:IN_Cod_Pin_Persona);'

            )
       INSERT FOR MISSING UPDATE ROWS
    END
    
    ,CASE WHEN IN_Severidad_UD < 3 THEN 
		('UPDATE '||@BDDATOS||'.'||@TablaDestino4||'  
        	SET IND_UNIFICACION = 1
        	,LOTE_ACTUALIZACION = '||@LOTE||'
        	,Fecha_Modificacion = CURRENT_DATE
        	WHERE Cod_DW_Persona_Ubic=:IN_Cod_DW_Persona_Ubic
        	;')
	
	IGNORE MISSING UPDATE ROWS   /* IGNORA ERRORES EN LA ACTUALIZACION */
    END 	
           
    TO OPERATOR (OPERATOR_130 [1])
    SELECT * FROM OPERATOR (FEXP_OPERATOR);      
    );
   
 STEP Update_Table_MaxID
 (
       APPLY   
       
        ('UPDATE '|| @BDMTDAT ||'.MAX_ID
               SET    ID = (SELECT COALESCE(MAX(Cod_DW_Direccion_Fisica),0) FROM '||@BDDATOS||'.'||@TablaDestino3||')
               WHERE  Nombre_Tabla = '''||@TablaDestino3||'''
        ;')
,
        ('UPDATE '|| @BDMTDAT ||'.MAX_ID
               SET    ID = (SELECT COALESCE(MAX(Cod_DW_Persona_Ubic),0) FROM '||@BDDATOS||'.'||@TablaDestino4||')
               WHERE  Nombre_Tabla = '''||@TablaDestino4||'''
        ;')


         TO OPERATOR (DDL_OPERATOR);
 );
 
);
