BTQ=`echo $0 | awk -F"/" '{print $(NF)}'`
export REPORTE=${LOGS}/${BTQ}.log

rm -r ${REPORTE} 2>/dev/null

# Ejecuta SP
bteq<<BTEQ
	.logon ${Logon};
	DATABASE ${BDDATOS};
	
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET WIDTH 254
	.SET SEPARATOR '|'
	
	.EXPORT REPORT FILE=${REPORTE}
	
	CALL PRO_CreaDicNomenclaturaReg2
	(
		${lote}
		,'${dateTimeStartPro}'
		,'${process}'
		,'${BDDATOS}'
		,'${BDVISTA}'
		,'${BDSTAGE}'
		,P_ERROR
	) ;
	
	.EXPORT reset
BTEQ

if [ $? -ne 0 ]
	then echo 'Error en ejecucion BTEQ'
	exit 3
fi

IdProceso=`cat ${REPORTE} |tail -1`
echo $IdProceso >${REPORTE}
vError=`cat ${REPORTE} | awk -F"|" '{print $1}'`
vError=`echo ${vError}` 
vCantError=`echo ${#vError}`

rm -r ${REPORTE} 2>/dev/null

if [ $vCantError -gt 0 ]
	then
	exit 3
fi

exit 0
