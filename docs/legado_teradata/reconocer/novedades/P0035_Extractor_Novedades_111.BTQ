# Definicion nombre del proceso
BTQ=`echo $0 | awk -F"/" '{print $(NF)}'`
# Definicion de Logs de ejecucion
export REPORTE=${LOGS}/${BTQ}.log

rm -r ${REPORTE} 2>/dev/null

## Actulización ruta parametros salidas
grep -v SALIDAS1 ${PARAMETROS}/${process}.par >${PARAMETROS}/${process}.partmp
echo "SALIDAS1 = '"${SALIDAS}"'" >>${PARAMETROS}/${process}.partmp

#1
mv -f ${PARAMETROS}/${process}.partmp ${PARAMETROS}/${process}.par 

if [ $? == 1 ] 
then
   echo 'Error en la actualización de parametros validar permisos en ${PARAMETROS}/${process}.par'
   exit 3
else
   echo "ok actualizacion de parametros"
fi
#1 

### COMIENZA BTEQ
bteq<<BTEQU
	.logon ${Logon};
	
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET WIDTH 254
	.SET SEPARATOR '|'
	
	.EXPORT REPORT FILE=${REPORTE}
	
	SELECT USER;
	
	DELETE FROM ${BDMTDAT}.LOG_TD 
	WHERE Nombre_Proceso = 'P0035_Extractor_Novedades';
	
	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND
	
	.EXPORT reset
BTEQU

if [ $? -ne 0 ]
	then echo 'Error en ejecucion BTEQ, identificacion de USUARIO'
	exit 3
fi

User=`cat ${REPORTE} |tail -1`
echo $User >${REPORTE}
User=`cat ${REPORTE} | awk -F"|" '{print $1}'`
User=`echo ${User}` 

rm -r ${REPORTE} 2>/dev/null

# Ejecuta SP

rm -f ${PARAMETROS}/Validac_key.txt;

bteq<<BTEQU3
	.logon ${Logon};
	DATABASE ${BDDATOS};
	.EXPORT DATA FILE=${PARAMETROS}/Validac_key.txt;
	
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET WIDTH 254
	.SET SEPARATOR '|'
	
	CALL PRO_Novedad_Linea_Catalogo
	(
		${lote}
		,'${dateTimeStartPro}'
		,'${process}'
		,'${BDDATOS}'
		,'${BDVISTA}'
		,'${BDSTAGE}'
		,'${BDMTDAT}'
		,P_ERROR
	) ;

	.EXPORT reset;
	.logoff;
.quit;
BTEQU3

Salida_VALID_KEY=`grep SQLCODE ${PARAMETROS}/Validac_key.txt`

if [ $? == 0 ] 
then
   echo 'Error en ejecucion del procedimiento PRO_Novedad_Linea_Catalogo'
   echo "VALID_KEY=$Salida_VALID_KEY"
   rm -f ${PARAMETROS}/Validac_key.txt;
   exit 3
else
   echo "BTEQ Procedure Ejecutado Satisfactoriamente"

fi

