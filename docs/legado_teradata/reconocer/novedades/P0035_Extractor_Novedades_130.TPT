	/* ===========================================================================================
        Apply Upsert Usando Mload Desde lo que entrega la vstg a MAT_INFO_ACTIVIDAD_ECONOMICA
       =========================================================================================== */
    
	STEP Load_MAT_INFO_ACTIVIDAD_ECONOMICA
    (             
		APPLY        
		CASE 
			WHEN ( IN_Severidad = 1  ) /*  Upsert  */
			THEN 				 
			(	
				'UPDATE '||@BDDATOS ||'.'||@TablaDestino2||'
				SET CIIU = :IN_CIIU                          
				   ,ACTIVIDAD_ECONOMICA = :IN_ACTIVIDAD_ECONOMICA           
				   ,VERSION             = :IN_VERSION                       
				   ,FECHA_REPORTE       =    CAST(:IN_FECHA_REPORTE AS DATE FORMAT ''YYYYMMDD'')
				WHERE ID = :IN_ID;'	 
				,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino2||' 
				( 
				ID
				,CIIU
				,ACTIVIDAD_ECONOMICA
				,VERSION								
				,FECHA_REPORTE
				,INFO_BASICA_ID	
				,TIPO_IDENTIFICACION
				,NUMERO_IDENTIFICACION
				)  
				VALUES     
				(
				:IN_ID
				,:IN_CIIU
				,:IN_ACTIVIDAD_ECONOMICA
				,:IN_VERSION
				,CAST(:IN_FECHA_REPORTE AS DATE FORMAT ''YYYYMMDD'') 
				,:IN_INFO_BASICA_ID
				,:IN_TIPO_IDENTIFICACION
				,:IN_NUMERO_IDENTIFICACION
				);'
			)
			INSERT FOR MISSING UPDATE ROWS
		END,
		
		CASE 
			WHEN ( IN_Severidad = 2  ) /*  Borrar registros que no este en Reporte  */
			THEN ('DELETE FROM ' || @BDDATOS || '.'||@TablaDestino2||' WHERE ID = :IN_ID;')
		END		

		TO OPERATOR (OPERATOR_131 [1])
		SELECT * FROM OPERATOR (MAT_INFO_ACTIVIDAD_ECONOMICA);      
    );
	
	STEP Load_MAT_INFO_BASICA
	(
		APPLY        
		CASE 
			WHEN ( IN_Severidad = 1  ) /*  Upsert  */
			THEN 				 
			(	
				'UPDATE '||@BDDATOS ||'.'||@TablaDestino3||'
				SET  PRIMER_NOMBRE = :IN_PRIMER_NOMBRE
				, SEGUNDO_NOMBRE = :IN_SEGUNDO_NOMBRE
				, PRIMER_APELLIDO = :IN_PRIMER_APELLIDO
				, SEGUNDO_APELLIDO = :IN_SEGUNDO_APELLIDO
				, NOMBRE_COMPLETO  = :IN_NOMBRE_COMPLETO 
				, COD_TIPO_IDENT_FTE  = :IN_COD_TIPO_IDENT_FTE 
				, TIPO_IDENTIFICACION  = :IN_TIPO_IDENTIFICACION 
				, NUMERO_IDENTIFICACION = :IN_NUMERO_IDENTIFICACION
				, ESTADO_DOCUMENTO  = :IN_ESTADO_DOCUMENTO 
				, RANGO_EDAD  = :IN_RANGO_EDAD 
				, LUGAR_EXPEDICION = :IN_LUGAR_EXPEDICION
				, FECHA_EXPEDICION  = CAST(:IN_FECHA_EXPEDICION AS DATE FORMAT ''YYYYMMDD'')
				, GENERO  = :IN_GENERO 
				, CIIU  = :IN_CIIU 
				, ACTIVIDAD_ECONOMICA  = :IN_ACTIVIDAD_ECONOMICA 
				, RAZON_SOCIAL  = :IN_RAZON_SOCIAL 
				, PAGINA_WEB = :IN_PAGINA_WEB
				, MOSAIC_ID = :IN_MOSAIC_ID
				, DEPARTAMENTO_EXPEDICION = :IN_DEPARTAMENTO_EXPEDICION
				, RUT  = :IN_RUT
				WHERE ID = :IN_ID;'	 
				,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino3||' 
				(
				COD_PIN_PERSONA /*#3*/		
				,ID 
				,PRIMER_NOMBRE
				,SEGUNDO_NOMBRE
				,PRIMER_APELLIDO
				,SEGUNDO_APELLIDO
				,NOMBRE_COMPLETO 
				,COD_TIPO_IDENT_FTE 
				,TIPO_IDENTIFICACION 
				,NUMERO_IDENTIFICACION
				,ESTADO_DOCUMENTO 
				,RANGO_EDAD 
				,LUGAR_EXPEDICION
				,FECHA_EXPEDICION 
				,GENERO 
				,CIIU 
				,ACTIVIDAD_ECONOMICA 
				,RAZON_SOCIAL 
				,PAGINA_WEB
				,MOSAIC_ID
				,DEPARTAMENTO_EXPEDICION					                      
				,RUT
				)  
				VALUES     
				( :IN_COD_PIN_PERSONA /*#3*/
				,:IN_ID 
				,:IN_PRIMER_NOMBRE
				,:IN_SEGUNDO_NOMBRE
				,:IN_PRIMER_APELLIDO
				,:IN_SEGUNDO_APELLIDO
				,:IN_NOMBRE_COMPLETO 
				,:IN_COD_TIPO_IDENT_FTE 
				,:IN_TIPO_IDENTIFICACION 
				,:IN_NUMERO_IDENTIFICACION
				,:IN_ESTADO_DOCUMENTO 
				,:IN_RANGO_EDAD 
				,:IN_LUGAR_EXPEDICION
				,CAST(:IN_FECHA_EXPEDICION AS DATE FORMAT ''YYYYMMDD'') 
				,:IN_GENERO 
				,:IN_CIIU 
				,:IN_ACTIVIDAD_ECONOMICA 
				,:IN_RAZON_SOCIAL 
				,:IN_PAGINA_WEB
				,:IN_MOSAIC_ID
				,:IN_DEPARTAMENTO_EXPEDICION
				,:IN_RUT
				);'
			)  

		INSERT FOR MISSING UPDATE ROWS
		END,
		
		CASE 
			WHEN ( IN_Severidad = 2  ) /*  Borrar registros que no este en Reporte  */
			THEN ('DELETE FROM ' || @BDDATOS || '.'||@TablaDestino3||' WHERE ID = :IN_ID;')
		END		

