DEFINE JOB P0035_Extractor_Novedades_130
DESCRIPTION 'Paso del Proceso de carga sobre tabla final MAT_INFO_UBICACION, MAT_INFO_ACTIVIDAD_ECONOMICA a partir de las vstg'
