	/* ================================================================
	   Definicion de (Tabla(s) Destino) MAT_INFO_BASICA_DELTA
	   ================================================================  */
	DEFINE OPERATOR DDL_OPERATOR
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
    TYPE DDL
    ATTRIBUTES
    (
      VARCHAR UserName        = @UserName,      
      VARCHAR UserPassword    = @UserPassword,   
      VARCHAR TdpId           = @TdpId,          
      VARCHAR ARRAY ErrorList = ['3803','3807','2574','9686'] 
    );
	
    /* ====================================================================
        Apply Upsert Usando Mload Desde lo que entrega la vstg
       ====================================================================  */
    
	STEP Load_MAT_INFO_UBICA_OPERATOR
    (             
		APPLY        
		CASE 
			WHEN ( IN_Severidad = 1  ) /*  Upsert  */
			THEN 				 
			(	
				'UPDATE '||@BDDATOS ||'.'||@TablaDestino1||'
				SET     
				ORDEN = :IN_ORDEN
				,INDICATIVO = :IN_INDICATIVO
				,DATO = :IN_DATO
				,ESTRATO = :IN_ESTRATO
				,TIPO = :IN_TIPO
