		SELECT * FROM OPERATOR (MAT_INFO_BASICA);      
	);
   
	STEP Load_MAT_INFO_CONTACTABILIDAD
    (             
		APPLY        
		CASE 
			WHEN ( IN_Severidad = 1  ) /*  Upsert  */
			THEN 				 
			( 
				'UPDATE '||@BDDATOS ||'.'||@TablaDestino4||'
				SET CONTACTABILIDAD= :IN_CONTACTABILIDAD
				,FECHA_ULTIMO_CONTACTO = CAST(:IN_FECHA_ULTIMO_CONTACTO AS TIMESTAMP(6))
				,Fecha_Gestion = CAST(:IN_Fecha_Gestion AS TIMESTAMP(6))
				,MEJOR_DIA_GESTION= :IN_MEJOR_DIA_GESTION
				,MEJOR_HORA_GESTION= :IN_MEJOR_HORA_GESTION
				,REPORTADO_POR= :IN_REPORTADO_POR												
				,PESO= :IN_PESO
				,MEJOR_RESULTADO_3MESES= :IN_MEJOR_RESULTADO_3MESES
				,MEJOR_RESULTADO_6MESES= :IN_MEJOR_RESULTADO_6MESES
				WHERE ID = :IN_ID
				AND SECTOR = :IN_SECTOR
				AND UBICACION_ID  = :IN_UBICACION_ID '

				,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino4||' 
				( 
				ID
				,CONTACTABILIDAD 	
				,FECHA_ULTIMO_CONTACTO
				,Fecha_Gestion								
				,MEJOR_DIA_GESTION
				,MEJOR_HORA_GESTION
				,REPORTADO_POR
				,SECTOR 
				,UBICACION_ID 
				,PESO
				,MEJOR_RESULTADO_3MESES
				,MEJOR_RESULTADO_6MESES					                      
				)  
				VALUES     
				(
				:IN_ID
				,:IN_CONTACTABILIDAD 	
				,CAST(:IN_FECHA_ULTIMO_CONTACTO AS TIMESTAMP(6))
				,CAST(:IN_Fecha_Gestion AS TIMESTAMP(6))
				,:IN_MEJOR_DIA_GESTION
				,:IN_MEJOR_HORA_GESTION
				,:IN_REPORTADO_POR
				,:IN_SECTOR 
				,:IN_UBICACION_ID 
				,:IN_PESO
				,:IN_MEJOR_RESULTADO_3MESES
				,:IN_MEJOR_RESULTADO_6MESES
				);'  
			)                   
		INSERT FOR MISSING UPDATE ROWS
		END,
		CASE 
			WHEN ( IN_Severidad = 2  ) /*  Borrar registros que no este en Reporte  */
			THEN 				 
			(
			  'DELETE FROM ' || @BDDATOS || '.'||@TablaDestino4||' 
			   WHERE ID = :IN_ID
			   AND SECTOR = :IN_SECTOR
			   AND UBICACION_ID  = :IN_UBICACION_ID'	 
			)
		END		

