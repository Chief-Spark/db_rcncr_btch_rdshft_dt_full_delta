	,IN_Cod_DW_Direccion_Fisica BIGINT
	,IN_Cod_DW_Telefono BIGINT
	,IN_Cod_DW_Direccion_Electronica BIGINT
	,IN_Ind_Unificacion INTEGER
	,IN_Cod_DW_Tipo_Ubicacion_Dir INTEGER
	,IN_Cod_Pin_Persona INTEGER	
	,IN_Severidad  BYTEINT
	,IN_FLAG_OP BYTEINT
    );    
	
