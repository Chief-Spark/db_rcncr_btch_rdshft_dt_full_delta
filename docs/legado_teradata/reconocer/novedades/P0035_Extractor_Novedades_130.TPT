	STEP Load_MAT_UBICACION_AGREGADA
	(             
		APPLY        
		CASE 
			WHEN ( IN_Severidad = 1  ) /*  Upsert  */
			THEN 				 
			( 
				'UPDATE '||@BDDATOS ||'.'||@TablaDestino7||'
				SET CODIGO_DANE= :IN_CODIGO_DANE
				,CIUDAD= :IN_CIUDAD
				,DEPARTAMENTO= :IN_DEPARTAMENTO							
				,UBICACION_REPORTDESDE= CAST(:IN_UBICACION_REPORTDESDE AS DATE FORMAT ''YYYYMMDD'')
				,UBICACION_ULTREPORTE= CAST(:IN_UBICACION_ULTREPORTE AS DATE FORMAT ''YYYYMMDD'') 
				,UBICACION_NUMENTIDADES= :IN_UBICACION_NUMENTIDADES
				,UBICACION_NUMREPORTES= :IN_UBICACION_NUMREPORTES
				,UBICACION_CLASE= :IN_UBICACION_CLASE
				,UBICACION_TIPOCUENTA= :IN_UBICACION_TIPOCUENTA
				,UBICACION_ORDEN= :IN_UBICACION_ORDEN
				,UBICACCION_INDICATIVO= :IN_UBICACCION_INDICATIVO
				,UBICACION_ESTRATO= :IN_UBICACION_ESTRATO
				,UBICACION_ZONA= :IN_UBICACION_ZONA
				,UBICACION_BARRIO= :IN_UBICACION_BARRIO
				,UBICACION_LOCALIDAD= :IN_UBICACION_LOCALIDAD
				,UBICACION_CODIGOPOSTAL= :IN_UBICACION_CODIGOPOSTAL
				,UBICACION_LONGITUD = CAST( :IN_UBICACION_LONGITUD AS DECIMAL(38,8))
				,UBICACION_LATITUD = CAST( :IN_UBICACION_LATITUD AS DECIMAL(38,8))
				,TIPO= :IN_TIPO
				,FUENTE = :IN_FUENTE  
				,ID = :IN_ID
				,COD_PAIS = :IN_COD_PAIS
				WHERE INFO_BASICA =   :IN_INFO_BASICA
				AND TIPO_IDENTIFICACION	= :IN_TIPO_IDENTIFICACION
				AND NUMERO_IDENTIFICACION = :IN_NUMERO_IDENTIFICACION
				AND UBICACION_DATO = :IN_UBICACION_DATO
				AND UBICACION_CODIGODANE = :IN_UBICACION_CODIGODANE
				AND UBICACION_CIUDAD = :IN_UBICACION_CIUDAD
				AND UBICACION_DEPARTAMENTO = :IN_UBICACION_DEPARTAMENTO'
				,'INSERT INTO ' || @BDDATOS || '.'||@TablaDestino7||' 
				( 
				TIPO_IDENTIFICACION
				,NUMERO_IDENTIFICACION
				,INFO_BASICA
				,CODIGO_DANE
				,CIUDAD
				,DEPARTAMENTO
				,UBICACION_DATO
				,UBICACION_REPORTDESDE
				,UBICACION_ULTREPORTE
				,UBICACION_NUMENTIDADES
				,UBICACION_NUMREPORTES
				,UBICACION_CLASE
				,UBICACION_TIPOCUENTA
				,UBICACION_ORDEN
				,UBICACCION_INDICATIVO
				,UBICACION_ESTRATO
				,UBICACION_ZONA
				,UBICACION_CIUDAD
				,UBICACION_DEPARTAMENTO
				,UBICACION_CODIGODANE
				,UBICACION_BARRIO
				,UBICACION_LOCALIDAD
				,UBICACION_CODIGOPOSTAL
				,UBICACION_LONGITUD 
				,UBICACION_LATITUD
				,TIPO
				,FUENTE 
				,ID 
				,COD_PAIS								   
				)  
				VALUES     
				(
				:IN_TIPO_IDENTIFICACION
				,:IN_NUMERO_IDENTIFICACION
				,:IN_INFO_BASICA
				,:IN_CODIGO_DANE
				,:IN_CIUDAD
				,:IN_DEPARTAMENTO
				,:IN_UBICACION_DATO
				,CAST(:IN_UBICACION_REPORTDESDE AS DATE FORMAT ''YYYYMMDD'')
				,CAST(:IN_UBICACION_ULTREPORTE AS DATE FORMAT ''YYYYMMDD'') 
				,:IN_UBICACION_NUMENTIDADES
				,:IN_UBICACION_NUMREPORTES
				,:IN_UBICACION_CLASE
				,:IN_UBICACION_TIPOCUENTA
				,:IN_UBICACION_ORDEN
				,:IN_UBICACCION_INDICATIVO
				,:IN_UBICACION_ESTRATO
				,:IN_UBICACION_ZONA
				,:IN_UBICACION_CIUDAD
				,:IN_UBICACION_DEPARTAMENTO
				,:IN_UBICACION_CODIGODANE
				,:IN_UBICACION_BARRIO
				,:IN_UBICACION_LOCALIDAD
				,:IN_UBICACION_CODIGOPOSTAL
				,CAST( :IN_UBICACION_LONGITUD AS DECIMAL(38,8))
				,CAST( :IN_UBICACION_LATITUD AS DeCIMAL(38,8))
				,:IN_TIPO
				,:IN_FUENTE 
				,:IN_ID 
				,:IN_COD_PAIS
				);'
			)                   
		INSERT FOR MISSING UPDATE ROWS
		END,
		
		CASE 
			WHEN ( IN_Severidad = 2  ) /*  Borrar registros que no este en Reporte  */
			THEN 				 
			(
				'DELETE FROM ' || @BDDATOS || '.'||@TablaDestino7||' 
				WHERE INFO_BASICA =   :IN_INFO_BASICA
				AND TIPO_IDENTIFICACION	= :IN_TIPO_IDENTIFICACION
				AND NUMERO_IDENTIFICACION = :IN_NUMERO_IDENTIFICACION
				AND UBICACION_DATO = :IN_UBICACION_DATO
				AND UBICACION_CODIGODANE = :IN_UBICACION_CODIGODANE
				AND UBICACION_CIUDAD = :IN_UBICACION_CIUDAD
				AND UBICACION_DEPARTAMENTO = :IN_UBICACION_DEPARTAMENTO'
			)
		END
		
		TO OPERATOR (OPERATOR_136 [1])
		SELECT * FROM OPERATOR (MAT_UBICACION_AGREGADA);      
	);

);     