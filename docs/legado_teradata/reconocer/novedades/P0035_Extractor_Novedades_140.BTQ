LOGON="$TdpId/$UserName,$UserPassword"
TablaDestino1=`cat $HOMER/parametros/P0035_Extractor_Novedades.par|grep TablaDestino1|awk -F"=" '{print $2}'|awk -F"'" '{print $2}'`
TablaDestino2=`cat $HOMER/parametros/P0035_Extractor_Novedades.par|grep TablaDestino2|awk -F"=" '{print $2}'|awk -F"'" '{print $2}'`
