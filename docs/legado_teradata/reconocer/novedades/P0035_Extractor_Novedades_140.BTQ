SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_UBICA_AGR_NRO_ENTIDADES';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
