.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.TMP_HIST_ETAPA_7 ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_NCONTACT_AGR_SECTOR';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.TMP_NCONTACT_AGR_SECTOR ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_UBICA_ETAPA_2';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
