.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.TMP_INBAS_ETAPA_9_2 ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'Persona_Sin_Ubic';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.Persona_Sin_Ubic ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_INBAS_ETAPA_9_1';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.TMP_INBAS_ETAPA_9_1 ALL;


.LABEL OK
.QUIT 0;
.Label ERRORFOUND
/*Se presento un fallo al limpiar las tablas*/
.Label ERRORFOUND1
/*Fallo al ejecutar drop de las tablas stage*/
.LOGOFF
.EXIT 13
EOF
}
FncLimpiarTablasBK(){
bteq << EOF
.logon ${LOGON};
.SET WIDTH 500

SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_BASICA';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_BASICA ALL;

SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_CONTACTABILIDAD';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_CONTACTABILIDAD ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_ACTIV_ECONOMICA';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_ACTIV_ECONOMICA ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_MOVILIDAD';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_MOVILIDAD ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_PUNTO_INTERES';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_PUNTO_INTERES ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_INFO_UBICACION';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_INFO_UBICACION ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDDATOS}' AND TableName = 'BK_MAT_UBICACION_AGREGADA';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDDATOS}.BK_MAT_UBICACION_AGREGADA ALL;

.LABEL OK
.QUIT 0;
.Label ERRORFOUND
/*Se presento un fallo al limpiar las tablas Backup*/
.Label ERRORFOUND1
/*Fallo al ejecutar drop de las tablas stage*/
.LOGOFF
.EXIT 13
EOF
}

FncCollectSTAT

FncCallPICTL

