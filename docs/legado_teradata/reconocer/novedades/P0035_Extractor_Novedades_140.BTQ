.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_UBICA_ETAPA_7';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
DELETE ${BDSTAGE}.TMP_UBICA_ETAPA_7 ALL;

.LABEL OK
SELECT 1 FROM dbc.Tables WHERE databasename = '${BDSTAGE}' AND TableName = 'TMP_UBICA_ETAPA_41';
.IF ACTIVITYCOUNT = 0 THEN .GOTO OK
