BDMTDAT1=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDMTDAT|awk -F"=" '{print $2}'`
BDDATOS1=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDDATOS|awk -F"=" '{print $2}'`
BDSTAGE=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDSTAGE|awk -F"=" '{print $2}'`
BDTEMPO=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDTEMPO|awk -F"=" '{print $2}'`
BDVISTA=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDVISTA|awk -F"=" '{print $2}'`
BDDATOS=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDDATOS|awk -F"=" '{print $2}'`
BDMTDAT=`cat $HOMER/parametros/Snapshot/Snapshot.par|grep BDMTDAT|awk -F"=" '{print $2}'`
