SALIDAS1=`grep SALIDAS1 ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO.par|awk -F"'" '{print $2}'`
FileName=`grep FileName ${PARAMETROS}/P0033_BATCH2_EXPORTLOG.par|awk -F"'" '{print $2}'`

echo -e "\n" | cat - $SALIDAS1/$FileName"_W" >> $SALIDAS1/$FileName
rm -f $SALIDAS1/$FileName"_W"
