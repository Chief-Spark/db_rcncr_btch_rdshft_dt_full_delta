set -x

LOGFILE=${vLog}
export LOGFILE
touch ${LOGFILE}
exec </dev/null
exec >${LOGFILE} 2>&1


IDPLANTILLA=`grep IDPLANTILLA ${PARAMETROS}/P0033_BATCH2_PROCESACUBOS.par|awk -F"=" '{print $2}'`
IDSOLICITUD=`grep IDSOLICITUD ${PARAMETROS}/P0033_BATCH2_PROCESACUBOS.par|awk -F"=" '{print $2}'`


echo $IDPLANTILLA
echo $IDSOLICITUD

BTQ=`echo $0 | awk -F"/" '{print $(NF)}'`
export REPORTE=${LOGS}/${BTQ}.log

rm -r ${REPORTE} 2>/dev/null

# Ejecuta SP
bteq<<BTEQ
	.logon ${Logon};
	DATABASE ${BDDATOS};
	
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET WIDTH 254
	.SET SEPARATOR '|'
	
	.EXPORT REPORT FILE=${REPORTE}
	
	CALL PRO_BATCH2_FILTRO_A
	(
		${lote}
		,'${dateTimeStartPro}'
		,'${process}'
		,'${BDVISTA}'
		,'${BDSTAGE}'
		,'${BDMTDAT}'
		,${IDPLANTILLA}
		,${IDSOLICITUD}
		,P_ERROR
	) ;

.if Errorcode <> 0 Then .Goto ERRORFOUND
	
SEL Descripcion_Teradata_Error
FROM ${BDMTDAT}.LOG_TD_DETALLE
WHERE Descripcion_Teradata_Error <> 'Finalizo Exitosamente'
and  Lote = ${lote};
	
.IF  ACTIVITYCOUNT > 0 THEN .Goto ERRORFOUND

	
.Label DONE
.QUIT 0

/* ===================== */
/* ERRORS                */
/* ===================== */

.Label ERRORFOUND
.REMARK '#### FALLO FILTRO_A Ver Tabla LOG_TD_DETALLE'
.EXIT 104
	
	
	.EXPORT reset
BTEQ

if [ $? -ne 0 ]
	then echo 'Error en ejecucion BTEQ'
	exit 3
else
   echo "BTEQ Procedure Ejecutado Satisfactoriamente"
fi


IdProceso=`cat ${REPORTE} |tail -1`
echo $IdProceso >${REPORTE}
vError=`cat ${REPORTE} | awk -F"|" '{print $1}'`
vError=`echo ${vError}` 
vCantError=`echo ${#vError}`

rm -r ${REPORTE} 2>/dev/null

if [ $vCantError -gt 0 ]
	then
	exit 3
fi

