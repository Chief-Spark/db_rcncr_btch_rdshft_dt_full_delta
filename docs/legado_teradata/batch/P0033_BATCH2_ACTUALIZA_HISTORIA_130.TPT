DEFINE JOB P0033_BATCH2_ACTUALIZA_HISTORIA                                                     
DESCRIPTION 'Proceso P0033_BATCH2_ACTUALIZA_HISTORIA - Estadisticas y Borrado tablas temporales' 
(   
    /* ================================================================     
       Definición del Operador "Bteq"                                       
       ================================================================  */ 
    
    DEFINE OPERATOR BTEQ_OPERATOR                            
    DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR' 
    TYPE DDL                                                 
    ATTRIBUTES                                               
    ( 
      VARCHAR UserName     = @UserName,      
      VARCHAR UserPassword = @UserPassword,  
      VARCHAR TdpId        = @TdpId,         
      VARCHAR ErrorList    = '3807'  
    ); 
          
    /* ====================================================================     
       Estadisticas de las Tablas Destino                                       
       ====================================================================  */ 
    
    STEP Bteq_Act_solicitud
    (
      APPLY    
             ('DELETE FROM '||@BDDATOS||'.BATCH_HISTORIA_RESULTADOS 
				WHERE ID_Solicitud = '||@IDSOLICITUD||';' 
		   	),
			 
			 ('INSERT INTO  '||@BDDATOS||'.BATCH_HISTORIA_RESULTADOS
				SELECT ID_SOLICITUD, ID_PLANTILLA, COD_DW_PERSONA_UBIC,FECHA_EJECUCION,Id_Buro_Suscriptor
				FROM REC_STAGE.V_Stg_Hist_Resultado_TMP
				WHERE ID_Solicitud = '||@IDSOLICITUD||'
				GROUP BY 1,2,3,4,5;'
			 ),
			 
    		 ('UPDATE '||@BDSTAGE||'.BATCH_SOLICITUD_BATCH
              SET			  
			 ESTADO = ''GENERADO''
			,FECHA_GENERACION = CURRENT_TIMESTAMP(6)
             WHERE ID_SOLICITUD = '||@IDSOLICITUD||'
			 AND ESTADO IS NULL
			 AND FECHA_GENERACION IS NULL;')
		  
      TO OPERATOR ( BTEQ_OPERATOR );
    );    
	
	
	
);
