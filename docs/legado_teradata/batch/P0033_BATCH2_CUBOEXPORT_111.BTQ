	Select
		 A.ID_SOLICITUD
		,A.ID_PLANTILLA
		,A.NOMBRE_SECCION
		,A.NOMBRE_SUBSECCION
		,A.CODIGO_SUBSECCION
		,A.NOMBRE_CAMPO
