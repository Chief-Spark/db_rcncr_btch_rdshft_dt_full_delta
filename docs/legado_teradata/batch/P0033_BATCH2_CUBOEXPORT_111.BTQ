		,A.COMA
		,A.PRINCIPAL
		,A.TIPOCAMPO
		,A.DEFAULTCAMPO
		,A.Ordenamiento
		,1000 SubOrden
	From	${BDSTAGE}.vstg_BA2_CAMPOS A
