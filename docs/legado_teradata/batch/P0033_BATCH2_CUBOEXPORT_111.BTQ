# INICIA BTEQ
bteq<<BTEQ
.logon ${Logon};

REPLACE VIEW ${BDSTAGE}.v_BA2_CamposBase AS
	LOCK ROW FOR ACCESS
	-- Persona
	SELECT
		 A.ID_SOLICITUD
		,A.ID_PLANTILLA
		,A.NOMBRE_SECCION
		,A.NOMBRE_SUBSECCION
		,A.CODIGO_SUBSECCION
		,A.NOMBRE_CAMPO
		,A.Cubo
		,A.Grupo_Campo
		,A.Codigo_Campo
		,A.Homologado as Valor_Ini
