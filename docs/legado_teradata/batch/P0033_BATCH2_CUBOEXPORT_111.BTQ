			ROW_NUMBER() OVER (PARTITION BY ID_BURO_PERSONA ORDER BY orden_prioridad, fecha_ultima_actualizacion DESC,CIUDAD) AS Cant_Dir /*#1*/
			From ${BDSTAGE}.BATCH_CUBO_DIRECCION
