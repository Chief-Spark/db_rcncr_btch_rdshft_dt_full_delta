REPLACE FUNCTION REC_VISTA.Bach_Similitud_Dir_VIA  (
		CiudadInsumoIn VARCHAR(500)
		,DirInsumoIn VARCHAR(500)
		,inDaneInsumo VARCHAR(20)
		,CiudadBodegaIn VARCHAR(500)
		,DirBodegaIn VARCHAR(500)
		,inDaneBodega VARCHAR(20)
		
		,PorCiudadIn INTEGER
		,PorDireccionIn INTEGER
		,PorComplementoIn INTEGER
		
		,PorTipoViaPpalIn INTEGER
		,PorNumViaPpalIn INTEGER
		,PorModViaPpalIn INTEGER
		,PorViaGenIn INTEGER
		
		,PorModViaGenIn INTEGER
		
		,PorNumPlacaIn INTEGER
		
		,PorCuadranteIn INTEGER
		
		,PorHitMz0In INTEGER
		,PorDisMz0In INTEGER
		,PorHitMz1In INTEGER
		,PorDisMz1In INTEGER
		,PorHitMz2In INTEGER
		,PorDisMz2In INTEGER
		,PorHitMz3In INTEGER
		,PorDisMz3In INTEGER
/*
 * ############################################################################
 * 
 * Objetivo:	  Aplicar el algoritmo de comparacion de direcciones fisicas de tipo
 *		  VIA
 * Fecha:	  2017/04/24
 * Realizado por: Luis E Ramirez (Capgemini)
 * Parametros:	  CiudadInsumoIn ,DirInsumoIn ,CiudadBodegaIn ,DirBodegaIn ,PorCiudadIn
 *		  ,PorDireccionIn ,PorComplementoIn ,PorTipoViaPpalIn ,PorNumViaPpalIn
 *		  ,PorModViaGenIn ,PorViaGenIn ,PorModViaGenIn ,PorNumPlacaIn
		  ,PorCuadranteIn
 *		  retorna INTEGER
 * Proyecto:	  Experian - Reconocer
 * Script:	  Bach_Similitud_Dir_VIA.BTQ
 * 
 * 
 * 
