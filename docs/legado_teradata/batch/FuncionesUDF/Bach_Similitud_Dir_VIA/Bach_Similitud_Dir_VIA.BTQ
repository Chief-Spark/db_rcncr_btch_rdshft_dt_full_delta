 * 
 * 
 * ############################################################################
 */
 )
	RETURNS INTEGER
	--RETURNS VARCHAR(500)
	LANGUAGE C
	NO SQL
	SPECIFIC BachSimilitudDirVIA
	EXTERNAL  NAME 'CI!operationsString!/reconocer/pruebas/fuentes/udfs/library/operationsString.h!CI!AddressNormalization!/reconocer/pruebas/fuentes/udfs/ADDRESS_NORMALIZATION/AddressNormalization.h!CI!loadParamsAcepAut!/reconocer/pruebas/fuentes/udfs/library/loadParamsAcepAut.h!CS!BachSimilitudDirVIA!/reconocer/pruebas/fuentes/udfs/Bach_Similitud_Dir_VIA/BachSimilitudDirVIA.c'
	PARAMETER STYLE TD_GENERAL
;




