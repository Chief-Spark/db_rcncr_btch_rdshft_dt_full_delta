.logon dbc/\$tdwallet(ucargareconocer),\$tdwallet(pcargareconocer);
.set width 254
REPLACE FUNCTION REC_VISTA.DataMasking (
		dato VARCHAR(200)
/*
 * ############################################################################
 * 
 * Objetivo:  Funcion  que realiza el enmascaramiento de datos numericos.
