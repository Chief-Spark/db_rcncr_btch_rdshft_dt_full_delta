 * ############################################################################
 */
 )
        RETURNS VARCHAR(500) 	
	LANGUAGE C
	NO SQL
	SPECIFIC DataMasking 
	EXTERNAL  NAME 'CS!DataMasking!/reconocer/$AMBIENTE/fuentes/udfs/DataMasking/DataMasking.c'
	PARAMETER STYLE TD_GENERAL
;
