	.SET SEPARATOR '|'

	Select Linea From ${BDSTAGE}.w_Borrar_001
	Where tipo = 'SQL_CONSULTA'
		and subtipo in (
		'HEADER_SELECT_SIMPLE'
		,'CUERPO'
		,'CUERPO_FIJO_BATCHVALIDACION_1'
		,'CUERPO_FIJO_BATCHVALIDACION_2'
		,'FROM'
		,'JOINS'
		,'WHERE'
		,'WHERE_PJ'
		,'GROUP_BY'
		,'GROUP_BY_BATCHVALIDACION_1'
		,'GROUP_BY_BATCHVALIDACION_2'
		,'CIERRE_SENCILLO'
		)
	Order By secuencia ;

	.EXPORT RESET


	-- Vista Completa PJPN
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_PJ_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'

	Select Linea From ${BDSTAGE}.w_Borrar_001
	Where tipo = 'SQL_CONSULTA'
		and subtipo in (
		'HEADER_VISTA_PNPJ'
		,'HEADER_SELECT_SECUENCIA'
		,'CUERPO'
		,'CUERPO_FIJO_BATCHVALIDACION_1'
		,'CUERPO_FIJO_BATCHVALIDACION_2'
		,'FROM'
		,'JOINS'
		,'WHERE'
		,'WHERE_PNPJ'
		,'GROUP_BY'
		,'GROUP_BY_VISTA'
		,'GROUP_BY_BATCHVALIDACION_1'
		,'GROUP_BY_BATCHVALIDACION_2'
		,'CIERRE_VISTA'
		)
	Order By secuencia ;

	.EXPORT RESET


	-- Vista PN
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'

	Select Linea From ${BDSTAGE}.w_Borrar_001
	Where tipo = 'SQL_CONSULTA'
		and subtipo in (
		'HEADER_VISTA_PN'
		,'HEADER_SELECT_SECUENCIA'
		,'CUERPO'
		,'CUERPO_FIJO_BATCHVALIDACION_1'
		,'CUERPO_FIJO_BATCHVALIDACION_2'
		,'FROM'
		,'JOINS'
		,'WHERE'
		,'WHERE_PN'
		,'GROUP_BY'
		,'GROUP_BY_VISTA'
		,'GROUP_BY_BATCHVALIDACION_1'
		,'GROUP_BY_BATCHVALIDACION_2'
		,'CIERRE_VISTA'
		)
	Order By secuencia ;

	.EXPORT RESET


	-- Vista PJ
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PJ_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'

	Select Linea From ${BDSTAGE}.w_Borrar_001
	Where tipo = 'SQL_CONSULTA'
		and subtipo in (
		'HEADER_VISTA_PJ'
		,'HEADER_SELECT_SECUENCIA'
		,'CUERPO'
		,'CUERPO_FIJO_BATCHVALIDACION_1'
		,'CUERPO_FIJO_BATCHVALIDACION_2'
		,'FROM'
		,'JOINS'
		,'WHERE'
		,'WHERE_PJ'
		,'GROUP_BY'
		,'GROUP_BY_VISTA'
		,'GROUP_BY_BATCHVALIDACION_1'
		,'GROUP_BY_BATCHVALIDACION_2'
		,'CIERRE_VISTA'
		)
	Order By secuencia ;

	.EXPORT RESET



	--	SQUEMA VISTA Inconsistencia
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_Inconsis_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'

	Select linea from ${BDSTAGE}.w_borrar_001 Where tipo = 'VISTA_INCONSISTENCIA' and subtipo = 'SQUEMA_VISTA' ;

	.EXPORT RESET

	
	
	.LABEL ERRORFOUND
	.REMARK '#### ERROR en el Export del Sentencia CON DATOS...'
	.EXIT ERRORCODE

.LOGOFF
.EXIT
BTEQ



# Recorte de la primera linea de titulos

sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_W.txt          > ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_Fin.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_Inconsis_W.txt > ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_Inconsis.txt

sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_PN_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia_PN.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_PJ_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia_PJ.txt

sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_PJ_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_PJ.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PJ_W.txt  >  ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PJ.txt


rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_W.txt
rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_W.txt
rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_PN_W.txt
rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Sentencia_PJ_W.txt

rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_PJ_W.txt
rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PN_W.txt
rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Vista_PJ_W.txt

rm -f ${PARAMETROS}/P0033_BATCH2_EXPORTPLANO/Squema_Inconsis_W.txt



##  Vistas Inconsistencias Parametrica

if [ "${varTIPO_SALIDA}" == "'FE_TXT'" ]
	then
# INICIA BTEQ
bteq<<BTEQ
.logon ${Logon};

--  Creacion Vistas Inconsistencias Formato Fijo
-- PNPJ
	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PNPJ AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as char(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as char(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as char(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as char(15)) AS NUMERO_ID 
		,CAST(BII.NOMBRE_COMPLETO as char(100)) AS NOMBRE_COMPLETO 
		,CAST(BII.NOMBRE_ENTIDAD as char(100)) AS NOMBRE_ENTIDAD 
		,CAST(BII.FECHA_EXPEDICION as char(20)) AS FECHA_EXPEDICION 
		,CAST(BII.CIUDAD_EXPEDICION as char(100)) AS CIUDAD_EXPEDICION 
		,CAST(BII.DEPARTAMENTO_EXPEDICION as char(100)) AS DEPARTAMENTO_EXPEDICION 
		,CAST(BII.ESTADO as char(100)) AS ESTADO 
		,CAST(BII.CAUSAL as char(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
	; 

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PN AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as char(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as char(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as char(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as char(15)) AS NUMERO_ID 
		,CAST(BII.NOMBRE_COMPLETO as char(100)) AS NOMBRE_COMPLETO 
		,CAST(BII.NOMBRE_ENTIDAD as char(100)) AS NOMBRE_ENTIDAD 
		,CAST(BII.FECHA_EXPEDICION as char(20)) AS FECHA_EXPEDICION 
		,CAST(BII.CIUDAD_EXPEDICION as char(100)) AS CIUDAD_EXPEDICION 
		,CAST(BII.DEPARTAMENTO_EXPEDICION as char(100)) AS DEPARTAMENTO_EXPEDICION 
		,CAST(BII.ESTADO as char(100)) AS ESTADO 
		,CAST(BII.CAUSAL as char(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
		INNER JOIN 
		( Select a.Cod_Tipo_Ident_Fte, UPPER(TRIM(b.Nombre_Tipo_Persona)) as Nombre_Tipo_Persona From ${BTTPRUVI}.vu_persona a Left Join ${BTTPRUVI}.v_tipo_persona b on a.Cod_DW_Tipo_Persona=b.Cod_DW_Tipo_Persona Group by 1,2 )
			as PNPJ ON BII.Tipo_Id=PNPJ.Cod_Tipo_Ident_Fte , 
			${BDSTAGE}.BATCH_DATOS_GENERALES BDG
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
		and BDG.id_solicitud = ${varSOLICITUD} and BDG.id_plantilla = ${varPLANTILLA} 
		and PNPJ.Nombre_Tipo_Persona = 'NATURALES' ; 

		.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PJ AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as char(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as char(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as char(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as char(15)) AS NUMERO_ID 
		,CAST(BII.NOMBRE_COMPLETO as char(100)) AS NOMBRE_COMPLETO 
		,CAST(BII.NOMBRE_ENTIDAD as char(100)) AS NOMBRE_ENTIDAD 
		,CAST(BII.FECHA_EXPEDICION as char(20)) AS FECHA_EXPEDICION 
		,CAST(BII.CIUDAD_EXPEDICION as char(100)) AS CIUDAD_EXPEDICION 
		,CAST(BII.DEPARTAMENTO_EXPEDICION as char(100)) AS DEPARTAMENTO_EXPEDICION 
		,CAST(BII.ESTADO as char(100)) AS ESTADO 
		,CAST(BII.CAUSAL as char(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
		INNER JOIN 
		( Select a.Cod_Tipo_Ident_Fte, UPPER(TRIM(b.Nombre_Tipo_Persona)) as Nombre_Tipo_Persona From ${BTTPRUVI}.vu_persona a Left Join ${BTTPRUVI}.v_tipo_persona b on a.Cod_DW_Tipo_Persona=b.Cod_DW_Tipo_Persona Group by 1,2 )
			as PNPJ ON BII.Tipo_Id=PNPJ.Cod_Tipo_Ident_Fte , 
			${BDSTAGE}.BATCH_DATOS_GENERALES BDG
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
		and BDG.id_solicitud = ${varSOLICITUD} and BDG.id_plantilla = ${varPLANTILLA} 
		and PNPJ.Nombre_Tipo_Persona = 'JURIDICAS' ; 

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	.LABEL ERRORFOUND
	.REMARK '#### ERROR en la Creación del Sentencia No. 1.'
	.EXIT ERRORCODE

.LOGOFF
.EXIT
BTEQ


else


# INICIA BTEQ
bteq<<BTEQ
.logon ${Logon};

	--  Creacion Vistas Inconsistencias Formato Variable
	-- PNPJ
	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PNPJ AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as varchar(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as varchar(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as varchar(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as varchar(15)) AS NUMERO_ID 
