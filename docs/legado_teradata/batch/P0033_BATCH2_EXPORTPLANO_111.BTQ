		,CAST(BII.CAUSAL as varchar(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
	; 

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PN AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as varchar(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as varchar(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as varchar(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as varchar(15)) AS NUMERO_ID 
		,CAST(BII.NOMBRE_COMPLETO as varchar(100)) AS NOMBRE_COMPLETO 
		,CAST(BII.NOMBRE_ENTIDAD as varchar(100)) AS NOMBRE_ENTIDAD 
		,CAST(BII.FECHA_EXPEDICION as varchar(20)) AS FECHA_EXPEDICION 
		,CAST(BII.CIUDAD_EXPEDICION as varchar(100)) AS CIUDAD_EXPEDICION 
		,CAST(BII.DEPARTAMENTO_EXPEDICION as varchar(100)) AS DEPARTAMENTO_EXPEDICION 
		,CAST(BII.ESTADO as varchar(100)) AS ESTADO 
		,CAST(BII.CAUSAL as varchar(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
		INNER JOIN 
		( Select a.Cod_Tipo_Ident_Fte, UPPER(TRIM(b.Nombre_Tipo_Persona)) as Nombre_Tipo_Persona From ${BTTPRUVI}.vu_persona a Left Join ${BTTPRUVI}.v_tipo_persona b on a.Cod_DW_Tipo_Persona=b.Cod_DW_Tipo_Persona Group by 1,2 )
			as PNPJ ON BII.Tipo_Id=PNPJ.Cod_Tipo_Ident_Fte , 
			${BDSTAGE}.BATCH_DATOS_GENERALES BDG
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
		and BDG.id_solicitud = ${varSOLICITUD} and BDG.id_plantilla = ${varPLANTILLA} 
		and PNPJ.Nombre_Tipo_Persona = 'NATURALES' ; 

		.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	REPLACE VIEW ${BDSTAGE}.vstg_INCONSIS_PJ AS 
	LOCK ROW FOR ACCESS
	Select 
		 CAST(BII.ID_SOLICITUD as varchar(15)) AS ID_SOLICITUD 
		,CAST(BII.ID_PLANTILLA as varchar(15)) AS ID_PLANTILLA 
		,CAST(BII.TIPO_ID as varchar(5)) AS TIPO_ID 
		,CAST(BII.NUMERO_ID as varchar(15)) AS NUMERO_ID 
		,CAST(BII.NOMBRE_COMPLETO as varchar(100)) AS NOMBRE_COMPLETO 
		,CAST(BII.NOMBRE_ENTIDAD as varchar(100)) AS NOMBRE_ENTIDAD 
		,CAST(BII.FECHA_EXPEDICION as varchar(20)) AS FECHA_EXPEDICION 
		,CAST(BII.CIUDAD_EXPEDICION as varchar(100)) AS CIUDAD_EXPEDICION 
		,CAST(BII.DEPARTAMENTO_EXPEDICION as varchar(100)) AS DEPARTAMENTO_EXPEDICION 
		,CAST(BII.ESTADO as varchar(100)) AS ESTADO 
		,CAST(BII.CAUSAL as varchar(100)) AS CAUSAL 
	From	${BDSTAGE}.BATCH_IDENTIFICACIONES_INCONS BII 
		INNER JOIN 
		( Select a.Cod_Tipo_Ident_Fte, UPPER(TRIM(b.Nombre_Tipo_Persona)) as Nombre_Tipo_Persona From ${BTTPRUVI}.vu_persona a Left Join ${BTTPRUVI}.v_tipo_persona b on a.Cod_DW_Tipo_Persona=b.Cod_DW_Tipo_Persona Group by 1,2 )
			as PNPJ ON BII.Tipo_Id=PNPJ.Cod_Tipo_Ident_Fte , 
			${BDSTAGE}.BATCH_DATOS_GENERALES BDG
	Where BII.ID_SOLICITUD = ${varSOLICITUD} and  BII.ID_PLANTILLA = ${varPLANTILLA} 
		and BDG.id_solicitud = ${varSOLICITUD} and BDG.id_plantilla = ${varPLANTILLA} 
		and PNPJ.Nombre_Tipo_Persona = 'JURIDICAS' ; 

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	.LABEL ERRORFOUND
	.REMARK '#### ERROR en la Creación de la Sentencia No. 2	.'
	.EXIT ERRORCODE

.LOGOFF
.EXIT
BTEQ

fi




if [ $? -ne 0 ]
	then echo 'Error en ejecucion BTEQ'
	exit 3
