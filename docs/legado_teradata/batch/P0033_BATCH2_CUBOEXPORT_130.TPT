DEFINE JOB ExportarArchivo
DESCRIPTION 'Exporta Registros Formato Horizontal'
( 

DEFINE OPERATOR DDL_OPERATOR
 DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
 TYPE DDL
 ATTRIBUTES
 (
   VARCHAR UserName     = @UserName      
  ,VARCHAR UserPassword = @UserPassword  
  ,VARCHAR TdpId        = @TdpId         
 );

 

STEP Creacion_Tabla_BD_Telefono
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_CUBOEXPORT/Sql_Create_Tel.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 

	
STEP Creacion_Tabla_BD_Celular
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_CUBOEXPORT/Sql_Create_Cel.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 

	
STEP Creacion_Tabla_BD_Direccion
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_CUBOEXPORT/Sql_Create_Dir.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 

	
STEP Creacion_Tabla_BD_Correo
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_CUBOEXPORT/Sql_Create_Cor.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 


STEP Creacion_Tabla_BD_Ciiu
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_CUBOEXPORT/Sql_Create_Cii.txt' )
		TO OPERATOR (DDL_OPERATOR);
