rm -f ${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Squema_Cii.txt


# INICIA BTEQ
bteq<<BTEQ
	.logon ${Logon};

	/*	Create de la Tabla Temporal  */
	-- Busca la tabla Si existe y la borra
	SELECT tablename 
	FROM dbc.tables 
	WHERE databasename = '${BDSTAGE}'
	AND tablename = 'w_Borrar_001' ;
	
	.IF ACTIVITYCOUNT = 0 THEN .GOTO CREA
	
	DROP TABLE ${BDSTAGE}.w_Borrar_001 ;
	

   .LABEL CREA
	CREATE SET TABLE ${BDSTAGE}.w_Borrar_001
(
	Secuencia	INTEGER
	,Linea		VARCHAR(5000)
	,Nada		INTEGER
)
	PRIMARY INDEX (Secuencia) ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND

	
	INSERT INTO ${BDSTAGE}.w_Borrar_001
	SELECT
	1,
	' '' 
	CREATE MULTISET TABLE REC_STAGE.w_cubo_ciiu AS (
	Select  Id_Buro_Persona /*  */
	'
	,0  ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND

	
	
	INSERT INTO ${BDSTAGE}.w_Borrar_001
	Select 
		SUM(1) OVER( ROWS UNBOUNDED PRECEDING ) + B.Secuencia
		,
		CASE
			when W.TipoCampo = 'ANSIDATE' then ', MAX(Case when Num = ' || Num || ' then to_char( ' ||  Valor_Ini || ', ''''dd/mm/yyyy'''')/*#1*/  End) ' || CampoNuevo || chr(13) 
		ELSE
			', MAX(Case when Num = ' || Num || ' then ' ||  Valor_Ini || ' End) ' || CampoNuevo || chr(13)	
		END
		, row_number() over(order by W.Contador) Q1 
		
	from
	(
		select A.*, Right( CampoNuevo,3) Num
		, row_number() over(order by A.Ordenamiento, A.CampoNuevo) Contador 
		from	${BDSTAGE}.v_BA2_CamposBase A
		where UPPER(A.cubo) = 'CIIU'
	) AS W
	,
	${BDSTAGE}.w_Borrar_001 B
	;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND



INSERT INTO ${BDSTAGE}.w_Borrar_001
	Select 
	10000
	,
	'
	,MAX(Filtro_D) Filtro_D 
	,MAX(Filtro_G) Filtro_G 
	,MAX(Filtro_H) Filtro_H 
	/*  */
	FROM
		(Select
			 Id_Buro_Persona 
			,CIIU 
			,RANK() OVER (PARTITION BY Id_Buro_Persona ORDER BY Id_Buro_Persona, fecha_actualizacion DESC, Ciiu ) as Num 
			,Actividad_Economica 
			,FECHA_ACTUALIZACION 
			,Version 
			,Filtro_D 
			,Filtro_G 
			,Filtro_H 
			/*  */
			From	REC_STAGE.BATCH_Cubo_ciiu 
			Where ciiu is not null 
				/* and	( Coalesce(Filtro_D,0) + Coalesce(Filtro_G,0)) = 0 */ 
			/*  */
			Group by 1,2,4,5,6,7,8,9 
			) AS X 
		/*  */
	Group by 1
	 /*  */ 
	) WITH DATA /*  */
	PRIMARY INDEX (Id_Buro_Persona) 
	'''
	,0 ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	--  EXPORTANDO
	--	Cabeza
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Cabeza_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'

	Select linea from ${BDSTAGE}.w_borrar_001 order by secuencia ;

	.EXPORT RESET	
 
 
 
 -- CREACION DINAMICA SQUEMA
REPLACE VIEW ${BDSTAGE}.v_Tempo_Borrar AS LOCK ROW FOR ACCESS
(
	Select 
		 TRIM(CampoNuevo) || ' ' || TRIM(TIPOCAMPO) CAMPO
		,row_number() OVER(order by ordenamiento, camponuevo) Orden 
	from
		(
			select A.*, Right( CampoNuevo,3) Num
			, row_number() over(order by A.Ordenamiento, A.CampoNuevo) Contador 
			from	${BDSTAGE}.v_BA2_CamposBase A
			where UPPER(A.cubo) = 'CIIU'
		) AS W
) ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND

	
	Delete ${BDSTAGE}.w_Borrar_001 ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	Insert Into ${BDSTAGE}.w_Borrar_001
		SELECT 1, 'Id_Buro_Persona  INTEGER ',0 ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND


	Insert Into ${BDSTAGE}.w_Borrar_001
	select	SUM(1) OVER( ROWS UNBOUNDED PRECEDING ) + B.Secuencia,
	',' || CAMPO || ' ' , 0
	from ${BDSTAGE}.v_Tempo_Borrar
		,
		${BDSTAGE}.w_Borrar_001 B ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND
	

	--  EXPORTANDO
	--	Squema
	.EXPORT FILE = '${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Squema_W.txt'
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET HEADING '';
	.SET WIDTH 30000
	.SET SEPARATOR '|'
	
	select linea from ${BDSTAGE}.w_borrar_001 order by secuencia ;

	.EXPORT RESET	



	/*	Create de la Tabla Temporal  */
	-- Busca la tabla Si existe y la borra
	SELECT tablename 
	FROM dbc.tables 
	WHERE databasename = '${BDSTAGE}'
	AND tablename = 'w_cubo_ciiu' ;
	
	.IF ACTIVITYCOUNT = 0 THEN .GOTO SIGUE_Cii

	DROP TABLE ${BDSTAGE}.w_cubo_ciiu ;

	.IF ERRORCODE <> 0 THEN .GOTO ERRORFOUND

	.LABEL SIGUE_Cii
	Select date ;

	.LABEL ERRORFOUND
	.REMARK '#### ERROR en la Creación de la tabla w_cubo_ciiu.'
	.EXIT ERRORCODE


	.LOGOFF
	.EXIT
BTEQ


# Recorte de la primera linea de titulos

sed -e '1d' ${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Cabeza_W.txt  >  ${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Sql_Create_Cii.txt
sed -e '1d' ${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Squema_W.txt  >  ${PARAMETROS}/P0033_BATCH2_CUBOEXPORT/Squema_Cii.txt

