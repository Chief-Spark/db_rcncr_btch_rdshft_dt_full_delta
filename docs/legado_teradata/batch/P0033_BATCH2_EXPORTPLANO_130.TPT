DEFINE JOB ExportarArchivo
DESCRIPTION 'Exporta Registros a BATCH2'
( 
 
 DEFINE SCHEMA Account_Schema
	( 
		INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Squema_Fin.txt' ;
	);

 DEFINE SCHEMA Inconsis_Schema
	( 
		INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Squema_Inconsis.txt' ;
	);



DEFINE OPERATOR Data_Connector_PNPJ
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Account_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @NOM_ARCHIVO||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 

DEFINE OPERATOR Data_Connector_PN
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Account_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @NOM_ARCHIVO||'_PN'||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 

DEFINE OPERATOR Data_Connector_PJ
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Account_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @NOM_ARCHIVO||'_PJ'||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 

DEFINE OPERATOR Data_Connector_Inconsis_PNPJ
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Inconsis_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @ARCHIVO_INCONSISTENCIA||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 

DEFINE OPERATOR Data_Connector_Inconsis_PN
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Inconsis_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @ARCHIVO_INCONSISTENCIA|| '_PN' ||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 

DEFINE OPERATOR Data_Connector_Inconsis_PJ
	TYPE DATACONNECTOR CONSUMER
	SCHEMA Inconsis_Schema
	ATTRIBUTES
	( VARCHAR 	
				DirectoryPath 	  = @SALIDAS1, 
				FileName 		  = @ARCHIVO_INCONSISTENCIA|| '_PJ' ||@FCH_ARCHIVO||@EXTENCION||'_W', 
				Format 			  = @FORMATO, 
				TextDelimiter	  = @DELIMITADOR, 
				IndicatorMode 	  = 'N', 
				OpenMode 		  = 'Write' 
		); 



DEFINE OPERATOR Select_PNPJ
 TYPE SELECTOR
 SCHEMA Account_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia.txt' 
 );

DEFINE OPERATOR Select_PN
 TYPE SELECTOR
 SCHEMA Account_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia_PN.txt' 
 );
 
DEFINE OPERATOR Select_PJ
 TYPE SELECTOR
 SCHEMA Account_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Sql_Sentencia_PJ.txt' 
 );
 
DEFINE OPERATOR Select_Incons_PNPJ
 TYPE SELECTOR
 SCHEMA Inconsis_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  'Select * From ' || @BDSTAGE || '.vstg_INCONSIS_PNPJ ; ' 
 );
 
DEFINE OPERATOR Select_Incons_PN
 TYPE SELECTOR
 SCHEMA Inconsis_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  'Select * From ' || @BDSTAGE || '.vstg_INCONSIS_PN ; ' 
 );
 
DEFINE OPERATOR Select_Incons_PJ
 TYPE SELECTOR
 SCHEMA Inconsis_Schema
 ATTRIBUTES
 (
 VARCHAR UserName 	  = @UserName,
 VARCHAR UserPassword = @UserPassword,
 VARCHAR TdpId = @TdpId,
 VARCHAR SelectStmt =  'Select * From ' || @BDSTAGE || '.vstg_INCONSIS_PJ ; ' 
 );
 
 

 
 DEFINE OPERATOR DDL_OPERATOR
 DESCRIPTION 'TERADATA PARALLEL TRANSPORTER DDL OPERATOR'
 TYPE DDL
 ATTRIBUTES
 (
   VARCHAR UserName     = @UserName 
  ,VARCHAR UserPassword = @UserPassword 
  ,VARCHAR TdpId        = @TdpId 
 );
 
 
 
 
STEP Creacion_Vista_BD_PNPJ
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Vista_PN_PJ.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 


STEP Creacion_Vista_BD_PN
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Vista_PN.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 


STEP Creacion_Vista_BD_PJ
	(
		APPLY
		( INCLUDE ''||@PARAMETROS || '/P0033_BATCH2_EXPORTPLANO/Vista_PJ.txt' )
		TO OPERATOR (DDL_OPERATOR);
	); 




	STEP Generacion_Tabla_Salida_PNPJ
	 (
		APPLY
			TO OPERATOR
			(Data_Connector_PNPJ[1])
	 
		SELECT  *
		FROM OPERATOR (Select_PNPJ[1]);
	 ); 

 
	STEP Generacion_Tabla_Salida_PN
	 (
		APPLY
			TO OPERATOR
			(Data_Connector_PN[1])
	 
		SELECT  *
		FROM OPERATOR (Select_PN[1]);
	 ); 

 
	STEP Generacion_Tabla_Salida_PJ
	 (
		APPLY
			TO OPERATOR
			(Data_Connector_PJ[1])
	 
		SELECT  *
		FROM OPERATOR (Select_PJ[1]);
	 ); 
 
 
 
	STEP Generacion_Tabla_Salida_Inconsis_PNPJ
	 (
		APPLY
			TO OPERATOR
			(Data_Connector_Inconsis_PNPJ[1])
	 
		SELECT  *
		FROM OPERATOR (Select_Incons_PNPJ[1]);
	 ); 
 
 
 ); 
 
 
 