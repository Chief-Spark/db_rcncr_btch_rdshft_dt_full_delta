echo "###############################################################################"
echo "Inicio proceso de la validacion de formatos - " $(date +%Y%m%d_%H%M%S)

echo ""
echo "Archivo log: "${LOGFILE}

echo ""
echo "PASO 1: Validando tipo de solicitud $id_solicitud - " $(date +%Y%m%d_%H%M%S)
