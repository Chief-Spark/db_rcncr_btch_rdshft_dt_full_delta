SALIDAS1=$(grep SALIDAS1 ${dp}P0037_BATCH_VFORNOM.par|awk -F"'" '{print $2}')

 if [ -d $SALIDAS1 ];then 
  echo "  El directorio que almacenara los archivos resultado del proceso es: "${SALIDAS1}   
  else 
