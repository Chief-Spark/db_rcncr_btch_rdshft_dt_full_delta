#  name: funGenerateLote
#  desc: Ejecuta SP PRO_BATCH_VALFORMAT
#  @param
#  @return
#
fncExecSP() {
echo ""
echo "PASO 6: Ejecucion SP - " $(date +%Y%m%d_%H%M%S)

bteq << EOF
.logon ${LOGONP};
.SET WIDTH 254
INSERT INTO $BDMTDAT.log_td (Lote, Fecha_Hora_Inicio, Nombre_Proceso, Tabla_Origen_Stage, Tabla_Destino_Prod, USuario_BD, Estado_Ejecucion)
SELECT $lote  Lote
	   ,CURRENT_TIMESTAMP(6) Fecha_Inicio
	   ,'P0037_BATCH_VFORNOM' Nombre_Proceso
	   ,'batch_valform_st1' Tabla_Origen_Stage
	   ,'batch_valform_st4' Tabla_Destino_Prod
	   ,User Usuario_BD
	   ,'Ejectuando SP' Estado_Ejecucion;

.if Errorcode <> 0 Then .Goto ERRORFOUND

 CALL $BDDATOS.PRO_BATCH_VALFORMAT($lote				 
				 ,CAST(CAST(CURRENT_DATE AS DATE FORMAT 'YYYY-MM-DD')AS VARCHAR(10))||''||CAST(current_Time AS VARCHAR(8) )
				 ,'P0037_BATCH_VFORNOM'
				 ,'$BDDATOS'
				 ,'$BDVISTA'
				 ,'$BDSTAGE'	
				 ,$id_solicitud
				 ,P_ERROR );
				 
.if Errorcode <> 0 Then .Goto ERRORFOUND1

.QUIT 0;
.Label ERRORFOUND
/*Se presento un fallo al insertar el lote*/
.Label ERRORFOUND1
/*Fallo al ejecutar el procedimiento/
.LOGOFF
.EXIT 13
EOF

logSP=$LOGS/"SOLICITUD_"${id_solicitud}"_ExecSPValformat.val"
if [ -f  $logSP ];then 
   rm -f $logSP
fi

bteq << EOF
.logon ${LOGON};
.SET FORMAT OFF
.SET FOLDLINE OFF
.SET SIDETITLES OFF
.SET RECORDMODE OFF
.SET WIDTH 900
.SET TITLEDASHES OFF
.SET UNDERLINE OFF
.SET SESSION CHARSET 'ASCII'
.EXPORT REPORT FILE=$logSP
    select ( Max(Descripcion_Teradata_Error) )(title '')  from rec_mtdat.log_td_detalle where lote = $lote and Descripcion_Teradata_Error <>  'Finalizo Exitosamente';
.EXPORT RESET
.QUIT;
EOF

err=$(cat $logSP|sed 's/ //g'|awk '{print length($0)}')
msg=$(cat $logSP|sed 's/ //g')

}

funValNom() {
