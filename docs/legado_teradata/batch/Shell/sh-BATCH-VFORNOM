#funcion que reemplaza el id de solicitud en el archivo de parametros del proceso. 
fncSetPar(){     
echo ""
echo "PASO 2: Actualiza id en archivo parametros - " $(date +%Y%m%d_%H%M%S)
    
  if [ $IDSOLICITUD -ne $id_solicitud ];then 
   sed "s/$IDSOLICITUD/$id_solicitud/g" ${dp}P0037_BATCH_VFORNOM.par > ${dp}P0037_BATCH_VFORNOM.par"1"
   mv ${dp}P0037_BATCH_VFORNOM.par"1" ${dp}P0037_BATCH_VFORNOM.par   
  fi    
BASEFILE=$(grep BASEFILE ${dp}P0037_BATCH_VFORNOM.par|awk -F"'" '{print $2}')
DATAFILE=$(grep "DATAFILE =" ${dp}P0037_BATCH_VFORNOM.par|awk -F"'" '{print $2}')
DATAFILE1=$(grep DATAFILE1 ${dp}P0037_BATCH_VFORNOM.par|awk -F"'" '{print $2}')

echo "  Crea el directorio salidas si no existe"
fncCreaDirSal
}

#funcion que crea el directorio salidas si no existe. 
