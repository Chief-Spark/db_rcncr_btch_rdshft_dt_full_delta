echo "PASO 8: Validacion de nombres - " $(date +%Y%m%d_%H%M%S)
# ================================================================
# Ejecucion de proceso carga identificaciones batch
# ================================================================
# Ejecuta SP
bteq<<BTEQ
	.logon ${LOGONP};
	DATABASE ${BDDATOS};
	
	.SET DEFAULTS
	.SET TITLEDASHES OFF
	.SET WIDTH 254
	.SET SEPARATOR '|'
	
	
	INSERT INTO ${BDMTDAT}.log_td (Lote, Fecha_Hora_Inicio, Nombre_Proceso, Tabla_Origen_Stage, Tabla_Destino_Prod, USuario_BD, IP_Maquina)
	SELECT $lote  Lote
	   ,CURRENT_TIMESTAMP(6) Fecha_Inicio
