#funcion que obtiene la solicitud y determina si es o no valida. 
fncGetSolicitud(){
echo ""
echo "PASO 1: Validando tipo de solicitud $id_solicitud - " $(date +%Y%m%d_%H%M%S) >> ${LOGFILE}

bteq << EOF
.logon ${LOGON};
.SET FORMAT OFF
.SET FOLDLINE OFF
.SET SIDETITLES OFF
.SET RECORDMODE OFF
.SET WIDTH 900
.SET TITLEDASHES OFF
.SET UNDERLINE OFF
.SET SESSION CHARSET 'ASCII'
.EXPORT REPORT FILE=$LOGS/SOLICITUD_$id_solicitud.val
    select ( Max(Nombre_Plantilla) )(title '')  from rec_stage.batch_solicitud_batch where id_solicitud = $id_solicitud;
.EXPORT RESET
.QUIT;
EOF

}

#funcion que obtiene la solicitud y determina si es o no valida. 
fncActPatron(){
echo "  Actualizar patrón en la solicitud $id_solicitud" >> ${LOGFILE}

bteq << EOF
.logon ${LOGONP};
.SET WIDTH 254

	UPDATE A
	FROM REC_STAGE.BATCH_VALFORM_ST1 A, REC_STAGE.BATCH_VALFORM_ST1_C B
	SET PATRON = B.PATRON
	WHERE A.TIPO_REGISTRO = B.TIPO_REGISTRO AND A.POSICION = B.POSICION AND A.ID = ${id_solicitud};

	.if Errorcode <> 0 Then .Goto ERRORFOUND

.QUIT 0;
.Label ERRORFOUND
/*Se presento un fallo al actualizar patrón*/

.LOGOFF
.EXIT 13
EOF

}

#funcion que crea el archivo Load.
fncGetFileLoad(){

 if [ -f $HOMER/entradas/$BASEFILE ]; then 
	echo "  - Validar cabecera"
    valHeader=$(head -1 $HOMER/entradas/$BASEFILE|grep -i tipo|wc -l)
	if [ $valHeader -gt 0  ]; then 	
		echo "   El archivo: "$HOMER/entradas/$BASEFILE" tiene cabecera, se remueve para el cargue"
		sed '1d' $HOMER/entradas/$BASEFILE > $HOMER/entradas/$BASEFILE"1"
		mv $HOMER/entradas/$BASEFILE"1" $HOMER/entradas/$BASEFILE
		chmod 777 $HOMER/entradas/$BASEFILE
	else
		echo "    El archivo no tiene cabecera"
	fi	 
	
	echo "  - Indicador tipo de solicitud"
	valTipoSol=$(echo $TIPO_SOLICITUD|grep -i validacion|wc -l)
	camposReq=3
	if [ $valTipoSol -gt 0 ]
	then 
		echo "    Tipo solicitud - CDCN = '1=1'"
		echo "    Campos Requeridos 9"
		camposReq=9 
		grep -v CDCN ${dp}P0037_BATCH_VFORNOM.par >  ${dp}P0037_BATCH_VFORNOM.par"1"	  
		echo "CDCN = '1=1'" >> ${dp}P0037_BATCH_VFORNOM.par"1"
		mv ${dp}P0037_BATCH_VFORNOM.par"1" ${dp}P0037_BATCH_VFORNOM.par
		echo "  - Exportando archivo de parametros para la validacion de formatos "
		echo "    SOLICITUD='${id_solicitud}'"
		tbuild -f $HOMER/fuentes/scripts/EXPORT_INFO_${TABLA1}.TPT -u "SOLICITUD='and ID = ${id_solicitud}'" -v $HOMER/parametros/P0037_BATCH_VFORNOM.par -j P0037_Export_${TABLA1} >> ${LOGFILE}
		echo "    Ejecuta TPT"
	else 
		echo "    Tipo solicitud - CDCN = 'obligatorio = 1'"
		echo "    Campos Requeridos 3"
		grep -v CDCN ${dp}P0037_BATCH_VFORNOM.par >  ${dp}P0037_BATCH_VFORNOM.par"1"
		echo "CDCN = 'obligatorio = 1'" >> ${dp}P0037_BATCH_VFORNOM.par"1"
		mv ${dp}P0037_BATCH_VFORNOM.par"1" ${dp}P0037_BATCH_VFORNOM.par
		echo "  - Exportando archivo de parametros para la validacion de formatos "
		echo "    SOLICITUD='${id_solicitud}'"
		tbuild -f $HOMER/fuentes/scripts/EXPORT_INFO_${TABLA1}.TPT -u "SOLICITUD='and obligatorio = 1 and ID = ${id_solicitud}'" -v $HOMER/parametros/P0037_BATCH_VFORNOM.par -j P0037_Export_${TABLA1} >> ${LOGFILE}
		echo "    Ejecuta TPT"
	fi

	echo "  - Validar tabla: " $SALIDAS1"/"$TABLA1
	ctlExp=$(wc -l $SALIDAS1/$TABLA1|awk '{print $1}')
	if [ $ctlExp -eq 0 ]; then 
		echo "    Error, No existen registros en la tabla "${TABLA1}" para ejecutar la validacion de formatos "
		exit 1
	fi
	
	echo "  - Validar registros vacíos"
	vacios=$(cat $HOMER/entradas/$BASEFILE|awk '{if(length($0)==0)print $0}'|wc -l)
	if [ $vacios -gt 0 ]; then 
		echo "    El archivo:"$HOMER/entradas/$BASEFILE" tiene "$vacios" registro(s) vacio(s), estos son eliminados"
		cat $HOMER/entradas/$BASEFILE|awk '{if(length($0)>0)print $0}' > $HOMER/entradas/$BASEFILE"1"
		mv $HOMER/entradas/$BASEFILE"1" $HOMER/entradas/$BASEFILE
	else
		echo "    El archivo no presenta registros vacíos"
	fi  	 

	echo "  - Validar separador"
	separador=$(head -1 $SALIDAS1/$TABLA1|awk -F"<@>" '{print $3}')
	if [ $separador = "/" ] 
	then
		echo "    El separador " $separador " no se permite, en el archivo de carga."
		exit 1
	else
		echo "    Separador: "$separador
	fi
	
	sed "s/$separador/<@>/g" $HOMER/entradas/$BASEFILE > $HOMER/entradas/$BASEFILE"1"
	mv $HOMER/entradas/$BASEFILE"1" $HOMER/entradas/$BASEFILE
	
	valSep=$(grep "<@>" $HOMER/entradas/$BASEFILE|wc -l)
	if [ $valSep -eq  0 ];then 	 
		echo "    Se mapeo mal el separador para el archivo:"$HOMER/entradas/$BASEFILE
		exit 1
	else 
		echo "    Registros sin cantidad de campos requeridos en: "$HOMER/entradas/$BASEFILE
		if [ $camposReq -eq 3 ];then 	   
			cat $HOMER/entradas/$BASEFILE|awk -F"<@>" '{if(NF<2) print $0}'	> $SALIDAS1/$DATAFILE1	
			cat $HOMER/entradas/$BASEFILE|awk -F"<@>" '{if(NF>2) print $0}' > $HOMER/entradas/$BASEFILE"1"
		else 
			cat $HOMER/entradas/$BASEFILE|awk -F"<@>" '{if(NF<8) print $0}'	> $SALIDAS1/$DATAFILE1	
			cat $HOMER/entradas/$BASEFILE|awk -F"<@>" '{if(NF>8) print $0}' > $HOMER/entradas/$BASEFILE"1"
		fi
		mv $HOMER/entradas/$BASEFILE"1" $HOMER/entradas/$BASEFILE

		echo "  - Generando archivo: "$SALIDAS1/$DATAFILE" para ejecutar el Load "
		valAF=$(cat $HOMER/entradas/$BASEFILE|wc -l)
		if [ $valAF -eq 0 ]; then 
			echo "    El archivo :"$HOMER/entradas/$BASEFILE" luego de la depuracion quedo sin registros"
			exit 1
		else  	   
			sed "s/<@>/$separador/g" $HOMER/entradas/$BASEFILE > $HOMER/entradas/$BASEFILE"1"
			mv $HOMER/entradas/$BASEFILE"1" $HOMER/entradas/$BASEFILE		
		fi 	   
	fi 
	
else 
	echo "  No existe el archivo: "$HOMER/entradas/$BASEFILE
	exit 1
fi   
}

#  name: funGenerateLote
#  desc: Genera Lote para la ejecucion actual
#  @param
#  @return
#
funGenerateLote() {
echo ""
echo "PASO 5: Generando Lote para invocar el SP - " $(date +%Y%m%d_%H%M%S)

rm -f $HOMER/logs/LOTE-VALFORM.batch

bteq <<EOF
	.logon ${LOGON};
	.REMARK  '####Seleccionar el Lote'
	LOCKING REC_MTDAT.LOTE_ID FOR EXCLUSIVE
	UPDATE REC_MTDAT.LOTE_ID
	SET Lote = coalesce(Lote, 0) + 1
	;
	.if Errorcode <> 0 Then .Goto ERRORFOUND

	.EXPORT DATA FILE = $HOMER/logs/LOTE-VALFORM.batch
	.SET RECORDMODE OFF;
	.set heading '';
	.set titledashes off;

	LOCKING REC_MTDAT.LOTE_ID FOR EXCLUSIVE
	SELECT Lote a
	FROM REC_MTDAT.LOTE_ID
	;
	.if Errorcode <> 0 Then .Goto ERRORFOUND

	.EXPORT RESET
	.LOGOFF

	.REMARK '#### LOTE obtenido con exito'
	.QUIT 0

	/* ===================== */
	/* ERRORS TERMINATE HERE */
	/* ===================== */
	.Label ERRORFOUND
	.REMARK '#### Error genera lote'
	.EXIT 12

	/*
	* Fin de la script
	*/
EOF
}

